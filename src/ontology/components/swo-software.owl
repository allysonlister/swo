            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/SWO_0040005"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SWO_0000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/SWO_0004004"/>
                <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/SWO_1200004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">cosmoGUI allows the user to interactively define constraint sets that can be used by the cosmo package to supervise the search for shared motifs in a set of DNA sequences. The constraints can be either adapted from a set of commonly used templates or defined from scratch.</obo:IAO_0000115>
        <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/cosmoGUI.html</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
        <rdfs:label xml:lang="en">cosmoGUI</rdfs:label>
    </owl:Class>
    


