    <owl:intersectionOf rdf:nodeID="Ncca5e49136f140bcb906618bd67ca694"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_1100052">
    <obo:IAO_0000115 xml:lang="en">This package contains functions for normalizing spotted microarray data, based on a physically motivated calibration model. The model parameters and error distributions are estiamted from external control spikes.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
