    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115 xml:lang="en">The GeneSpring-R integration package will allow you to expand the capability of GeneSpring by integrating R programs seamlessly into GeneSpring. With the integration package you will be able to use the power of R and BioConductor scripts in GeneSpring's rich graphical environment</obo:IAO_0000115>
    <obo:IAO_0000119>http://www.silicongenetics.com/cgi/SiG.cgi/Support/gs_r_int.smf</obo:IAO_0000119>
