  </rdf:Description>
  <rdf:Description rdf:nodeID="N70b9bc05810744d4b149021a56f45e58">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
