            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Mac OS is software which is used as the operating system for the Macintosh personal computer created by Apple Inc.</obo:IAO_0000115>
        <obo:IAO_0000119>http://en.wikipedia.org/wiki/History_of_Mac_OS, accessed 25 March 2015.</obo:IAO_0000119>
