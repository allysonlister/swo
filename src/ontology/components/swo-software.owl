    <rdfs:subClassOf rdf:nodeID="N6f6ad22ae5d74de882ad183d86f9eb6a"/>
    <obo:IAO_0000119>http://www.affymetrix.com/</obo:IAO_0000119>
    <rdfs:label xml:lang="en">Affymetrix Expression Console</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">Expression Console™ software supports probe set summarization and CHP file generation for 3' expression (e.g., GeneChip® Human Genome U133 Plus 2.0 Array), gene-level (e.g., GeneChip® Human Gene 1.0 ST array) and exon-level arrays (e.g., GeneChip® Human Exon 1.0 ST Array). The Expression Console workflow provides the user with a choice of the more commonly used probe set summarization algorithms</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
