        <obo:IAO_0000115 xml:lang="en">Weka (Waikato Environment for Knowledge Analysis) is a suite of machine learning software, originally intended for data mining tasks, written in Java and developed at the University of Waikato, New Zealand.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Weka</rdfs:label>
    </owl:Class>
    


