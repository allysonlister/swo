  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000452">
    <obo:IAO_0000115 xml:lang="en">affxparser is a package for parsing Affymetrix files (CDF, CEL, CHP, BPMAP, BAR). It provides methods for fast and memory efficient parsing of Affymetrix files using the Affymetrix' Fusion SDK.</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
