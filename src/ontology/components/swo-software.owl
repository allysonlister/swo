AnnotationAssertion(terms:creator obo:SWO_1100144 "Mark Reuter")
AnnotationAssertion(rdfs:comment obo:SWO_1100144 "AL 21.10.2019: Added in reference to https://github.com/allysonlister/swo/issues/23"@en)
