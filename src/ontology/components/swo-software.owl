            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">StavroX software identifies cross-linked peptides.</obo:IAO_0000115>
        <terms:creator>Allyson Lister</terms:creator>
        <terms:creator>Mark Reuter</terms:creator>
