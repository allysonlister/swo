            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">ArrayNorm is an platform-independent Java tool for normalization and statistical analysis for microarray-experiment data. It provides modules for visualization (scatterplot, histogram, boxplot, etc.), normalization and analysis.</obo:IAO_0000115>
        <obo:IAO_0000119>http://bin.tugraz.at/Tools/ArrayNorm.html</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
        <rdfs:label xml:lang="en">ArrayNorm</rdfs:label>
    </owl:Class>
    


