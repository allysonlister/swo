    <rdfs:subClassOf rdf:nodeID="N7188430bbde84c2d8f04e5ba43ef49d4"/>
    <rdfs:label xml:lang="en">'CALIB'</rdfs:label>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/CALIB.html</obo:IAO_0000119>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000635">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N23279d65eaf143c2b0bffaa0acbcd732"/>
    <rdfs:label xml:lang="en">nnNorm</rdfs:label>
