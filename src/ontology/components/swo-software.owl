            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">PostgreSQL, often simply Postgres, is an open source object-relational database management system (ORDBMS) with an emphasis on extensibility and standards compliance.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">PostgreSQL</rdfs:label>
    </owl:Class>
    


