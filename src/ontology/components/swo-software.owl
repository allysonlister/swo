  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000369">
    <obo:IAO_0000115 xml:lang="en">Rtreemix is a package that offers an environment for estimating the mutagenetic trees mixture models from cross-sectional data and using them for various predictions. It includes functions for fitting the trees mixture models, likelihood computations, model comparisons, waiting time estimations, stability analysis, etc.</obo:IAO_0000115>
    <rdfs:label xml:lang="en">Rtreemix</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nc0f5afd96c444068a44890b6b142bc2c"/>
