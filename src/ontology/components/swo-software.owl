    <obo:IAO_0000115 xml:lang="en">Define coerce methods for microarray data objects.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/convert.html</obo:IAO_0000119>
