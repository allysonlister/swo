  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000719">
    <obo:IAO_0000115 xml:lang="en">topGO package provides tools for testing GO terms while accounting for the topology of the GO graph. Different test statistics and different methods for eliminating local similarities and dependencies between GO terms can be implemented and applied.</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:subClassOf rdf:nodeID="Ned57bcf017154412bff8df3aa188646c"/>
