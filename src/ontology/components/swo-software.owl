            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This package contains a targeted clustering algorithm for the analysis of microarray data. The algorithm can aid in the discovery of new genes with similar functions to a given list of genes already known to have closely related functions.</obo:IAO_0000115>
        <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/geneRecommender.html</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
        <rdfs:label xml:lang="en">geneRecommender</rdfs:label>
    </owl:Class>
    


