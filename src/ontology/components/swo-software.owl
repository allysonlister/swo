    <obo:IAO_0000119>http://hmg.oxfordjournals.org/cgi/reprint/12/17/2145.pdf</obo:IAO_0000119>
    <obo:IAO_0000115 xml:lang="en">Microarray image quantification is performed using GLEAMS software</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
