  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000622">
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/miRNApath.html</obo:IAO_0000119>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:subClassOf rdf:nodeID="Neb68fc8642fc4e11b2403f3165608046"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000115 xml:lang="en">This package provides pathway enrichment techniques for miRNA expression data. Specifically, the set of methods handles the many-to-many relationship between miRNAs and the multiple genes they are predicted to target (and thus affect.) It also handles the gene-to-pathway relationships separately. Both steps are designed to preserve the additive effects of miRNAs on genes, many miRNAs affecting one gene, one miRNA affecting multiple genes, or many miRNAs affecting many genes.</obo:IAO_0000115>
    <rdfs:label xml:lang="en">miRNApath</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000662">
