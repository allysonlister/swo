    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000115 xml:lang="en">Statistical tools for building random mutagenesis libraries for prokaryotes. The package has functions for handling the occupancy distribution for a multinomial and for estimating the number of essential genes in random transposon mutagenesis libraries.</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label xml:lang="en">occugene</rdfs:label>
