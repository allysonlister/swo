    <rdfs:label xml:lang="en">exonmap</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">This package provides fine grained annotation of Affymetrix exon arrays, including mappings between the array probes and probesets and the Ensembl exons, transcripts and genes they target.</obo:IAO_0000115>
  </rdf:Description>
