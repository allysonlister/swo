  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000311">
    <rdfs:label xml:lang="en">OrderedList</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="Nf47cda4396ec41f2ba2da12d7f3f66cd"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/OrderedList.html</obo:IAO_0000119>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <obo:IAO_0000115 xml:lang="en">Detection of similarities between ordered lists of genes. Thereby, either simple lists can be compared or gene expression data can be used to deduce the lists. Significance of similarities is evaluated by shuffling lists or by resampling in microarray data, respectively.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N73bc3fcc6edb4af6acd0298bec3d2d1c">
    <rdf:first rdf:resource="http://purl.obolibrary.org/obo/SWO_9000055"/>
