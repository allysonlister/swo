  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000307">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N36fd2f3d610647679c4c0a3b81544ba7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <obo:IAO_0000115 xml:lang="en">This package allows to characterize the operating characeristics of a microarray experiment, i.e. the trade-off between false discovery rate and the power to detect truly regulated genes. The package includes tools both for planned experiments (for sample size assessment) and for already collected data (identification of differentially expressed genes).</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/OCplus.html</obo:IAO_0000119>
    <rdfs:label xml:lang="en">OCplus</rdfs:label>
  </rdf:Description>
