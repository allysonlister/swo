  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000432">
    <rdfs:label xml:lang="en">TAS Software</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000115 xml:lang="en">Tiling Analysis Software (TAS) is a freely downloadable tool for analysis, with which one can perform a simulation to assess the likelihood that an observed probe overlap region is different from the expected overlap with no enrichment from binding, and can derive an interval overlap report and/or computation of summary statistics.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
