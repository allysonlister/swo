  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_1100032">
    <obo:IAO_0000119>http://blast.ncbi.nlm.nih.gov/Blast.cgi</obo:IAO_0000119>
    <obo:IAO_0000115 xml:lang="en">BLAST, or Basic Local Alignment Search Tool in full, is an algorithm for comparing primary biological sequence information, such as the amino-acid  sequences of different proteins or the nucleotides  of DNA sequences.</obo:IAO_0000115>
    <rdfs:subClassOf rdf:nodeID="Ne8d7dd6fe1764bda972385ee4f08a1d4"/>
