    <rdfs:subClassOf rdf:nodeID="N9c88ee77eb364ddf80550b0383f85133"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/HELP.html</obo:IAO_0000119>
    <rdfs:label xml:lang="en">HELP</rdfs:label>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115 xml:lang="en">The package contains a modular pipeline for analysis of HELP microarray data, and includes graphical and mathematical tools with more general applications</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000236">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N83b6f4ef12b74b268f2d9a283e8e45e2"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000119>http://www.research.bidmc.harvard.edu/AcademicIT/ImageQuant.asp</obo:IAO_0000119>
    <rdfs:label xml:lang="en">ImageQuant</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">This is a general image analysis program used in the study of electrophoretic separations, dot blots, slot blots, microplate assays, TLC assays, and plaque assays. ImageQuant provides a point-and-click environment for fast analysis of qualitative and quantitative assays. With tools for accurate volume integration, ImageQuant generates accurate lane profiles even for curved or slanted lanes.</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
  </rdf:Description>
