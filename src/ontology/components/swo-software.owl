  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000525">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="Nbc95a8b62f1d488e8ba74c68938a5a71"/>
    <obo:IAO_0000115 xml:lang="en">Meta-data and tools to work with E. coli. The tools are mostly plotting functions to work with circular genomes. They can used with other genomes/plasmids.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/ecolitk.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label xml:lang="en">ecolitk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000671">
    <obo:IAO_0000115 xml:lang="en">The package contains functions to perform normalization of high-throughput qPCR data. Basic functions for processing raw Ct data plus functions to generate diagnostic plots are also available.</obo:IAO_0000115>
    <rdfs:subClassOf rdf:nodeID="N99a4b191a12f45e4bdf8225767a33de9"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
