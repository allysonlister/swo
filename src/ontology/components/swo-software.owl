                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Versarray ChipReader systems are highly sensitive laser confocal systems designed for rapid imaging of microarrays. These are advanced scanners that meet your expectations, differentiating between a spot response and background level, and optimizing the signal on the bottom as well as the top end of the range for increased sensitivity. Results with versarray chipreader systems have a low background, enhanced weak signal detection, and virtually no photobleaching for a long dye lifetime.</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.bio-medicine.org/</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
        <rdfs:label xml:lang="en">ChipReader 3.1</rdfs:label>
    </owl:Class>
    


