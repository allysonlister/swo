        <obo:IAO_0000115 xml:lang="en">This package is designed to provide solutions for quality assessment and to detect differentially expressed genes for the Affymetrix GeneChips, including both 3&apos; -arrays and gene 1.0-ST arrays.</obo:IAO_0000115>
        <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/ArrayTools.html</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
