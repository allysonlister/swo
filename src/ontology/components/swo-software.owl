    <rdfs:subClassOf rdf:nodeID="Nf4cc0c062e4340dcbfda6e3652a070eb"/>
    <rdfs:label xml:lang="en">LPEadj</rdfs:label>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/LPEadj.html</obo:IAO_0000119>
    <obo:IAO_0000115 xml:lang="en">Two options are added to the LPE algorithm. The original LPE method sets all variances below the max variance in the ordered distribution of variances to the maximum variance. in LPEadj this option is turned off by default. The second option is to use a variance adjustment based on sample size rather than pi/2. By default the LPEadj uses the sample size based variance adjustment.</obo:IAO_0000115>
  </rdf:Description>
