  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000641">
    <rdfs:subClassOf rdf:nodeID="Nc51f09167c7d4e7badd4ec63fdfc0f5b"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N527bacdd9c314de69c7fbfccf0a31908"/>
    <rdfs:subClassOf rdf:nodeID="N2740e5f6cdf9496c8ce5697b6fa7bc5c"/>
    <rdfs:subClassOf rdf:nodeID="N26f745a2eeb4474797bbdcc33b680373"/>
    <rdfs:subClassOf rdf:nodeID="N72be2e9b48b847ecb75ff8d2fe986b23"/>
    <rdfs:subClassOf rdf:nodeID="N39b898b4566c4cf2b0fda20f91248496"/>
    <rdfs:label xml:lang="en">oneChannelGUI</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/oneChannelGUI.html</obo:IAO_0000119>
    <obo:IAO_0000115 xml:lang="en">This package was developed to simplify the use of Bioconductor tools for beginners having limited or no experience in writing R code. This library provides a graphical interface allowing QC, filtering, statistical validation, and alternative splicing analysis.</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb70288f92f1e4062be7262cb103ddc42">
