  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_1100094">
    <rdfs:label xml:lang="en">'EBImage'</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">EBImage is an R package which provides general purpose functionality for the reading, writing, processing and analysis of images. Furthermore, in the context of microscopy based cellular assays, EBImage offers tools to transform the images, segment cells and extract quantitative cellular descriptors.</obo:IAO_0000115>
