    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000115 xml:lang="en">ScanArray Express provides superior spot finding and quantization algorithm. This combined with template adjustment features drives excellence in analysis performance.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000119>http://las.perkinelmer.com/Catalog/ProductInfoPage.htm?ProductID=7000060</obo:IAO_0000119>
  </rdf:Description>
