    <rdfs:label xml:lang="en">flowQ</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">This package provides quality control and quality assessment tools for flow cytometry data.</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
