  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000192">
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/GeneSelector.html</obo:IAO_0000119>
    <obo:IAO_0000115 xml:lang="en">The term 'GeneSelector' refers to a filter selecting those genes which are consistently identified as differentially expressed using various statistical procedures. 'Selected' genes are those present at the top of the list in various featured ranking methods (currently 15). In addition, the stability of the findings can be taken in account in the final ranking by examining perturbed versions of the original data set, e.g. by leaving samples, swapping class labels, generating bootstrap replicates or adding noise.</obo:IAO_0000115>
    <rdfs:label xml:lang="en">GeneSelector</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
  </rdf:Description>
