    <rdfs:subClassOf rdf:nodeID="N407e5a195f2a4a1684c248a4bd7c6259"/>
    <rdfs:subClassOf rdf:nodeID="Na4bdb853739e47ccb921de5bdebeeac1"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <obo:IAO_0000115 xml:lang="en">Tools to integrate, annotate, and link phenotypes to cellular organizational units such as protein complexes and pathways.</obo:IAO_0000115>
    <rdfs:label xml:lang="en">PCpheno</rdfs:label>
