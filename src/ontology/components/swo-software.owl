  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000451">
    <rdfs:label xml:lang="en">Acuity</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N6eb7409f74074a8da0711bdf69f684dc"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000119>http://www.bio-medicine.org/</obo:IAO_0000119>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <obo:IAO_0000115 xml:lang="en">Acuity is the complete enterprise microarray informatics platform for microarray data storage, data filtering and data analysis. It analysis tools for quality, visualizations for discovery and  Data Management for Security.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000079">
    <obo:IAO_0000119>http://www.cytoscape.org/what_is_cytoscape.html, Accessed June 20, 2012.</obo:IAO_0000119>
    <rdfs:label xml:lang="en">Cytoscape</rdfs:label>
    <dcterms:creator>Allyson Lister</dcterms:creator>
    <obo:IAO_0000115 xml:lang="en">Cytoscape is an open source bioinformatics software platform for visualizing molecular interaction networks and biological pathways and integrating these networks with annotations, gene expression profiles and other state data.</obo:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N5b26757aa1904881b000238c0228c244"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
