  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000660">
    <obo:IAO_0000115 xml:lang="en">The PLIER (Probe Logarithmic Error Intensity Estimate) method produces an improved signal by accounting for experimentally observed patterns in probe behavior and handling error at the appropriately at low and high signal values.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/plier.html</obo:IAO_0000119>
