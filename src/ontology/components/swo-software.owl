SubClassOf(obo:SWO_1100130 DataHasValue(obo:SWO_0004006 "https://satijalab.org/seurat/"))

# Class: obo:SWO_1100131 (Graphpad Prism)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_1100131 "GraphPad Prism is a commercial scientific 2D graphing and statistics software available for both Windows and Macintosh computers."@en)
AnnotationAssertion(terms:creator obo:SWO_1100131 "Allyson Lister")
AnnotationAssertion(rdfs:comment obo:SWO_1100131 "AL 8.10.2019: Added in reference to https://github.com/allysonlister/swo/issues/14"@en)
