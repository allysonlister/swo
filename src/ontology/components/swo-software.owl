                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SWO_7000018"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This LPE library is used to do significance analysis of microarray data with small number of replicates. It uses resampling based FDR adjustment, and gives less conservative results than traditional &apos;BH&apos; or &apos;BY&apos; procedures. Data accepted is raw data in txt format from MAS4, MAS5 or dChip. Data can also be supplied after normalization. LPE library is primarily used for analyzing data between two conditions. To use it for paired data, see LPEP library. For using LPE in multiple conditions, use HEM library.</obo:IAO_0000115>
        <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/LPE.html</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
        <rdfs:label xml:lang="en">LPE</rdfs:label>
    </owl:Class>
    


