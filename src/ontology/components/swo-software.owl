    <rdfs:subClassOf rdf:nodeID="Nddae272e3b674c6aa2931b4c7c399a38"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/pcaMethods.html</obo:IAO_0000119>
    <obo:IAO_0000115 xml:lang="en">A cluster based method for missing value estimationn is included for comparison. BPCA, PPCA and NipalsPCA may be used to perform PCA on incomplete data as well as for accurate missing value estimation. A set of methods for printing and plotting the results is also provided.</obo:IAO_0000115>
    <rdfs:label xml:lang="en">pcaMethods</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
