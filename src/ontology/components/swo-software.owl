  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000158">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N75581473350943e19060682a773d5734"/>
    <rdfs:subClassOf rdf:nodeID="Nb46b362ac94b47e8a0401604651e52e8"/>
    <rdfs:subClassOf rdf:nodeID="Ncaafe4123eba4bc297f8c3d7fbeb0571"/>
    <rdfs:subClassOf rdf:nodeID="Na24a7df97c3442a8ac417fd68cf185e5"/>
    <obo:IAO_0000119>http://sbml.org/SBML_Software_Guide/SBML_Software_Summary, accessed 27 March 2015.</obo:IAO_0000119>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115 xml:lang="en">LibSBML is a free, open-source programming library to help you read, write, manipulate, translate, and validate SBML files and data streams. It provides interfaces for C, C++, C#(.NET), Java, MATLAB, Octave, Perl, Python R and Ruby. LibSBML is available for free under LGPL terms in both source-code form and precompiled binaries for Windows, Mac OS X, and Linux.</obo:IAO_0000115>
    <rdfs:label xml:lang="en">libSBML</rdfs:label>
    <dcterms:creator>Allyson Lister</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000338">
    <rdfs:label xml:lang="en">RLMM</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N4977daa202724cdb8dcfbd57dd42d4e3"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <obo:IAO_0000115 xml:lang="en">A Genotype Calling Algorithm for Affymetrix SNP Arrays</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/RLMM.html</obo:IAO_0000119>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_1100129">
    <rdfs:label xml:lang="en">shinyNGS</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="Nc69db6746d324c698912fe47cd7b1e49"/>
    <rdfs:subClassOf rdf:nodeID="N7e9b7ae713214bd58007c387fb5536ff"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115 xml:lang="en">Shinyngs is an R package designed to facilitate downstream analysis of RNA-seq and similar expression data with various exploratory plots and data mining tools.</obo:IAO_0000115>
    <rdfs:comment xml:lang="en">AL 8.10.2019: Added in reference to https://github.com/allysonlister/swo/issues/12</rdfs:comment>
    <dcterms:creator>Allyson Lister</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000365">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000119>http://www.rosettabio.com/products/resolver</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label xml:lang="en">Rosetta Resolver</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115 xml:lang="en">The Rosetta Resolver® system provides a central analysis center and repository for biologists, statisticians, and bioinformaticians for the evaluation of gene expression data from microarrays and qPCR studies.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000485">
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label xml:lang="en">bioDist</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N8de90f59bdff4ab3b0dbd2ab5c2c6bc9"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/bioDist.html</obo:IAO_0000119>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115 xml:lang="en">The bioDist package contains some distance functions that have been shown to be useful in a number of dierent biological or bioinformatic problems. The return values are typically instances of the S3 class dist.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000527">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N9c9683f0a96140e4a4474928b37be666"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/edgeR.html</obo:IAO_0000119>
    <obo:IAO_0000115 xml:lang="en">Estimation and Testing for Differential Expression in Multiple Digital Gene Expression Libraries.</obo:IAO_0000115>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">'edgeR'</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N20d91187f6be465285d719a1a0df0e36">
