  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000213">
    <rdfs:subClassOf rdf:nodeID="N6b537bbcb2264121aca39a25d2cd797f"/>
    <rdfs:subClassOf rdf:nodeID="N1d59bfdda2c14ce79f8b16d051057e01"/>
