  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000472">
    <rdfs:label xml:lang="en">arrayMvout</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">This package supports the application of diverse quality metrics to AffyBatch instances, summarizing these metrics via PCA, and then performing parametric outlier detection on the PCs to identify aberrant arrays with a fixed Type I error rate</obo:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/arrayMvout.html</obo:IAO_0000119>
