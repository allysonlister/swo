  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000271">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label xml:lang="en">MIcroarray Analysis Suite</rdfs:label>
    <obo:IAO_0000119>http://www.affymetrix.com/support/technical/datasheets/mas_datasheet.pdf</obo:IAO_0000119>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N9efa328431e14e939d395e9998a6a906"/>
    <obo:IAO_0000115 xml:lang="en">Affymetrix® Microarray Suite (MAS) is the core software product in the Affymetrix Software System providing instrument control, data acquisition, and data analysis for the entire GeneChip® platform.</obo:IAO_0000115>
  </rdf:Description>
