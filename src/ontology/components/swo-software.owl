    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115 xml:lang="en">This package allows to detect and correct for spatial and intensity biases with two-channel microarray data. The normalization method implemented in this package is based on robust neural networks fitting.</obo:IAO_0000115>
  </rdf:Description>
