SubClassOf(obo:SWO_1100136 DataHasValue(obo:SWO_0004006 "https://www.spectralworks.com/products/analyzerpro/"))

# Class: obo:SWO_1100137 (SWATH Software)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_1100137 "SWATH is the only data independent acquisition (DIA) technique that allows comprehensive detection and quantitation of virtually every detectable compound in a sample (MS/MSALL). This provides confidence in your quantitative results and virtually eliminates the risk of missing a critical component. SWATH Acquisition strategy can only be achieved through the power and speed of SCIEX TripleTOF® and QTOF technology."@en)
AnnotationAssertion(terms:creator obo:SWO_1100137 "Allyson Lister")
AnnotationAssertion(terms:creator obo:SWO_1100137 "Mark Reuter")
AnnotationAssertion(rdfs:comment obo:SWO_1100137 "AL 21.10.2019: Added in reference to https://github.com/allysonlister/swo/issues/30"@en)
AnnotationAssertion(rdfs:label obo:SWO_1100137 "SWATH Software"@en)
