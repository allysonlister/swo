    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/PROcess.html</obo:IAO_0000119>
    <rdfs:subClassOf rdf:nodeID="N1951012df6b042c1847fcb277a95d91a"/>
    <rdfs:subClassOf rdf:nodeID="N0f1fec4651a24baead094a03d59d010d"/>
