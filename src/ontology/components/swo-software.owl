    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label xml:lang="en">gaga</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">This package fits Rossell's generalizations of the Gamma-Gamma hierarchical model for microarray data analysis, which substantially improve the quality of the fit at a low computational cost. The model can be fit via empirical Bayes (Expectation-Maximization and Simulated Annealing) and fully Bayesian techniques (Gibbs and Metropolis-Hastings posterior sampling).</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/gaga.html</obo:IAO_0000119>
  </rdf:Description>
