        <obo:IAO_0000115 xml:lang="en">The Affymetrix GeneChip Operating Software (GCOS) is an operating system software that controls Affymetrix instruments, acquires data, and executes gene expression analysis. In addition, GCOS contains an embedded database that manages both experiment information and data.</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.affymetrix.com</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
        <rdfs:label xml:lang="en">Affymetrix GeneChip Operating Software</rdfs:label>
    </owl:Class>
    


