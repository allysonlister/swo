  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000617">
    <obo:IAO_0000115 xml:lang="en">MDQC is a multivariate quality assessment method for microarrays based on quality control (QC) reports. The Mahalanobis distance of an array's quality attributes is used to measure the similarity of the quality of that array against the quality of the other arrays. Then, arrays with unusually high distances can be flagged as potentially low-quality.</obo:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:label xml:lang="en">mdqc</rdfs:label>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/mdqc.html</obo:IAO_0000119>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
  </rdf:Description>
