SubClassOf(obo:SWO_1100142 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/swo/has_license> obo:SWO_1000046))
SubClassOf(obo:SWO_1100142 DataHasValue(obo:SWO_0004006 "http://rseqc.sourceforge.net/"))

