        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/SWO_0000394"/>
                <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/SWO_1200000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Expression Console™ software supports probe set summarization and CHP file generation for 3&apos; expression (e.g., GeneChip® Human Genome U133 Plus 2.0 Array), gene-level (e.g., GeneChip® Human Gene 1.0 ST array) and exon-level arrays (e.g., GeneChip® Human Exon 1.0 ST Array). The Expression Console workflow provides the user with a choice of the more commonly used probe set summarization algorithms</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.affymetrix.com/</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
        <rdfs:label xml:lang="en">Affymetrix Expression Console</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SWO_1100006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SWO_1100006">
