  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_1100038">
    <rdfs:label xml:lang="en">BZScan</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">BZScan is a free java tool for automatic quantification of DNA microarrays with radioactive labeling. BZScan provides saturation, overshining, and background noise correction, it also gives quality control measures. It can work either in a fully automatic "batch mode" or at different levels of manual operation.</obo:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N2678eaf9fbb649fe86e4143dd4ae0aee"/>
    <obo:IAO_0000119>http://tagc.univ-mrs.fr/bioinformatics/bzscan/</obo:IAO_0000119>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
  </rdf:Description>
