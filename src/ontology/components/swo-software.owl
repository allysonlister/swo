  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000230">
    <rdfs:subClassOf rdf:nodeID="N1261186ceb0a49348ee500a746450a38"/>
    <rdfs:subClassOf rdf:nodeID="Nb9d0d0cd642f48fcb3ac34590e43926b"/>
    <rdfs:subClassOf rdf:nodeID="N8e4eb82ec22b48969723e339a3606b9d"/>
    <rdfs:subClassOf rdf:nodeID="Nf791c5f048b54d95b5cf08d344801e43"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label xml:lang="en">IRanges</rdfs:label>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/IRanges.html</obo:IAO_0000119>
    <obo:IAO_0000115 xml:lang="en">The IRanges class and its extensions are low-level containers for storing sets of integer ranges. A typical use of these containers in biology is for representing a set of chromosome regions. More specific extensions of the IRanges class will typically allow the storage of additional information attached to each chromosome region as well as a hierarchical relationship between these regions.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne0c51a7779c4470fae578c5f63d022f2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
