    <rdfs:label xml:lang="en">'DFP'</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">This package provides a supervised technique able to identify differentially expressed genes. The Fuzzy Patterns are built by means of applying 3 Membership Functions to discretized gene expression values.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/DFP.html</obo:IAO_0000119>
