        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_9000055"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                                <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/SWO_0000351"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000119>AIDA is a modular software package for evaluation and documentation of images that were obtained with digital devices such as CCD cameras, flat bed scanners, or BAS / FLA- scanners from Fuji. Additionally, AIDA allows the loading of loading a variety of images in other image formats (e.g.: TIFF, JPEG, Bmp, gel). AIDA can control all scanning devices offering a TWAIN compatible driver.</obo:IAO_0000119>
        <obo:IAO_0000119>http://www.raytest.de/index2.html</obo:IAO_0000119>
        <terms:creator>Nandini Badarinarayan</terms:creator>
        <rdfs:label xml:lang="en">AIDA</rdfs:label>
    </owl:Class>
    


