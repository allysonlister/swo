    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <obo:IAO_0000115 xml:lang="en">This package creates a QC report for an AffyBatch object. The report is intended to allow the user to quickly assess the quality of a set of arrays in an AffyBatch object.</obo:IAO_0000115>
  </rdf:Description>
