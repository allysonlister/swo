  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_1100055">
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/CMA.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N5e3e4244782942628c9cf4b3db00a0cf"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:label xml:lang="en">'CMA'</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">This package provides a comprehensive collection of various microarray-based classification algorithms both from Machine Learning and Statistics. Variable Selection, Hyperparameter tuning, Evaluation and Comparison can be performed combined or stepwise in a user-friendly environment.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000166">
    <rdfs:label xml:lang="en">GLEAMS software</rdfs:label>
