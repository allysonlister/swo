AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000751 "http://en.wikipedia.org/wiki/Dynamic_Bayesian_network, accessed 27 November 2014.")
AnnotationAssertion(rdfs:label obo:SWO_0000751 "dynamic Bayesian network model"@en)
SubClassOf(obo:SWO_0000751 obo:SWO_1100041)

# Class: obo:SWO_0000752 (ODE Algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000752 "In mathematics, an ordinary differential equation or ODE is an equation containing a function of one independent variable and its derivatives. The term \"ordinary\" is used in contrast with the term partial differential equation which may be with respect to more than one independent variable.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_0000752 "Ordinary Differential Equation Algorithm")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000752 "http://en.wikipedia.org/wiki/Ordinary_differential_equation, accessed 25 March 2015.")
AnnotationAssertion(dcterms:creator obo:SWO_0000752 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000752 "ODE Algorithm"@en)
SubClassOf(obo:SWO_0000752 obo:IAO_0000064)

# Class: obo:SWO_0000753 (Monte Carlo)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000753 "Monte Carlo is a discrete stochastic simulation algorithm and an estimation procedure algorithm. If it is necessary to know the average value of some random variable and its distribution can not be stated, and if it is possible to take samples from the distribution, we can estimate it by taking the samples, independently, and averaging them. If there are sufficiently enough samples, then the law of large numbers says the average must be close to the true value. The central limit theorem says that the average has a Gaussian distribution around the true value.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000753 "http://en.wikipedia.org/wiki/Stochastic_simulation#Monte_Carlo_simulation, accessed 25 March 2015, and http://www.async.ece.utah.edu/iBioSim/docs/iBioSim.html, accessed 25 March 2015.")
AnnotationAssertion(dcterms:creator obo:SWO_0000753 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000753 "Monte Carlo"@en)
SubClassOf(obo:SWO_0000753 obo:IAO_0000064)

# Class: obo:SWO_0000754 (DAE Algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000754 "Differential Algebraic equations (DAEs) are a general form of (systems of) differential equations for vector–valued functions in one independent variable. In practical terms, the distinction between DAEs and ODEs is often that the solution of a DAE system depends on the derivatives of the input signal and not just the signal itself as in the case of ODEs.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_0000754 "Differential Algebraic Equation Algorithm"@en)
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000754 "http://en.wikipedia.org/wiki/Differential_algebraic_equation, accessed 26 March 2015.")
AnnotationAssertion(dcterms:creator obo:SWO_0000754 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000754 "DAE Algorithm")
SubClassOf(obo:SWO_0000754 obo:IAO_0000064)

# Class: obo:SWO_0000755 (PDE Algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000755 "A partial differential equation (PDE) is a differential equation that contains unknown multivariable functions and their partial derivatives. This is in contrast to ordinary differential equations, which deal with functions of a single variable and their derivatives.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_0000755 "Partial Differential Equation Algorithm")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000755 "http://en.wikipedia.org/wiki/Partial_differential_equation, accessed 26 March 2015.")
AnnotationAssertion(dcterms:creator obo:SWO_0000755 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000755 "PDE Algorithm"@en)
SubClassOf(obo:SWO_0000755 obo:IAO_0000064)

# Class: obo:SWO_0000779 (Development status)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000779 "Development status is an information content entity which indicates the maturity of a software entity within the context of the software life cycle.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000779 "Allyson Lister")
AnnotationAssertion(dcterms:creator obo:SWO_0000779 "Andy Brown")
AnnotationAssertion(rdfs:label obo:SWO_0000779 "Development status")
SubClassOf(obo:SWO_0000779 obo:IAO_0000030)

# Class: obo:SWO_0000780 (alpha)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000780 "Alpha is a development status which is applied to software by the developer/publisher during initial development and testing. Software designated alpha is commonly unstable and prone to crashing. It may or may not be released publicly.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000780 "Modified from http://en.wikipedia.org/wiki/Software_release_life_cycle, accessed 11 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_0000780 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000780 "alpha")
SubClassOf(obo:SWO_0000780 obo:SWO_0000779)

# Class: obo:SWO_0000781 (beta)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000781 "Beta is a development status which is generally applied to software by the developer/publisher once the majority of features have been implemented, but when the software may still contain bugs or cause crashes or data loss. Software designated beta is often released publicly, either on a general release or to a specific subset of users called beta testers. ")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000781 "Modified from http://en.wikipedia.org/wiki/Software_release_life_cycle, accessed 11 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_0000781 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000781 "beta")
SubClassOf(obo:SWO_0000781 obo:SWO_0000779)

# Class: obo:SWO_0000782 (Release candidate)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000782 "A release candidate (RC) is a beta version with potential to be a final product, which is ready to release unless significant bugs emerge.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000782 "http://en.wikipedia.org/wiki/Software_release_life_cycle#Release_candidate, accessed 22 October 2014.")
AnnotationAssertion(rdfs:label obo:SWO_0000782 "Release candidate")
SubClassOf(obo:SWO_0000782 obo:SWO_0000779)

# Class: obo:SWO_0000783 (Live)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000783 "Live is a development status which is applied to software that has been designated as suitable for production environments by the developer/publisher. If a non-free product, software at this stage is available for purchase")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_0000783 "Production")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000783 "Allyson Lister, Jon Ison, and Modified from http://en.wikipedia.org/wiki/Software_release_life_cycle, accessed 11 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_0000783 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000783 "Live")
SubClassOf(obo:SWO_0000783 obo:SWO_0000779)

# Class: obo:SWO_0000785 (First release)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000785 "The first release of a piece of software. A first release does not imply any particular levels of maturity other than is this is the first instance of this software to be considered released.")
