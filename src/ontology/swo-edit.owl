# Class: obo:SWO_3000011 (BMP)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000011 "The BMP File Format is a Raster graphics image file format used to store bitmap digital images, independently of the display device (such as a graphics adapter).")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000011 "http://www.fileformat.info/format/bmp/egff.htm")
AnnotationAssertion(dcterms:creator obo:SWO_3000011 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_3000011 "BMP")
SubClassOf(obo:SWO_3000011 obo:SWO_3000020)

# Class: obo:SWO_3000012 (CGM)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000012 "Computer Graphics Metafile (CGM) is a free and open international standard file format for 2D vector graphics, raster graphics, and text, and is defined by ISO/IEC 8632.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000012 "http://en.wikipedia.org/wiki/Computer_Graphics_Metafile")
