  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_3000052">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
    <obo:IAO_0000115>A type of data which defines interactions between items in the file. This can be simple pairwise interactions or more complex ones. Used to provide a class of data for software requiring specific types of interaction data as input.</obo:IAO_0000115>
    <dcterms:creator>Allyson Lister</dcterms:creator>
    <rdfs:label xml:lang="en">Interaction data</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc86fb164e2084773a1ae3bf4208f7301">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/SWO_9001002"/>
