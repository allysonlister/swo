AnnotationAssertion(rdfs:label obo:SWO_3000032 "Microsoft Word doc")
SubClassOf(obo:SWO_3000032 obo:SWO_3000030)

# Class: obo:SWO_3000033 (programming language format)

AnnotationAssertion(rdfs:label obo:SWO_3000033 "programming language format")
SubClassOf(obo:SWO_3000033 obo:IAO_0000098)

# Class: obo:SWO_3000034 (.java file)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000034 "A source code file format which is specified to be used with the Java programming language.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000034 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_3000034 ".java file")
