# Object Property: <http://purl.obofoundry.org/obo/IAO_0000136> (is about)

AnnotationAssertion(obo:IAO_0000115 <http://purl.obofoundry.org/obo/IAO_0000136> "'is about' relates an information entity to other entities in which the information entity holds some information which dscribes some facet of the other entity, such as the arrow direction on a sign.")
AnnotationAssertion(obo:IAO_0000119 <http://purl.obofoundry.org/obo/IAO_0000136> "IAO")
AnnotationAssertion(obo:IAO_0000119 <http://purl.obofoundry.org/obo/IAO_0000136> "James Malone")
AnnotationAssertion(dcterms:creator <http://purl.obofoundry.org/obo/IAO_0000136> "Alan Ruttenberg"@en)
AnnotationAssertion(rdfs:label <http://purl.obofoundry.org/obo/IAO_0000136> "is about")
ObjectPropertyDomain(<http://purl.obofoundry.org/obo/IAO_0000136> obo:IAO_0000030)

# Object Property: obo:OBI_0000304 (is manufactured by)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0000304 "c is_manufactured_by o means that there was a process p in which c was
built in which a person, or set of people or machines did the work(bore
the \"Manufacturer Role\", and those people/and or machines were members
or of directed by the organization to do this.")
AnnotationAssertion(obo:IAO_0000119 obo:OBI_0000304 "OBI")
AnnotationAssertion(rdfs:label obo:OBI_0000304 "is manufactured by")
ObjectPropertyRange(obo:OBI_0000304 obo:OBI_0000245)

# Object Property: obo:RO_0000056 (participates in)

AnnotationAssertion(dcterms:creator obo:RO_0000056 "Andy Brown")
AnnotationAssertion(rdfs:comment obo:RO_0000056 "Please see the official RO definition for the inverse of this property, 'has participant.'")
AnnotationAssertion(rdfs:label obo:RO_0000056 "participates in")
InverseObjectProperties(obo:RO_0000056 obo:RO_0000057)

# Object Property: obo:RO_0000057 (has participant)

AnnotationAssertion(obo:IAO_0000112 obo:RO_0000057 "The relation obtains, for example, when this particular process of oxygen exchange across this particular alveolar membrane has_participant this particular sample of hemoglobin at this particular time.")
AnnotationAssertion(obo:IAO_0000115 obo:RO_0000057 "Has_participant is a primitive instance-level relation between a process, a continuant, and a time at which the continuant participates in some way in the process.")
AnnotationAssertion(obo:IAO_0000119 obo:RO_0000057 "http://obo-relations.googlecode.com/svn/trunk/src/ontology/core.owl")
AnnotationAssertion(dcterms:creator obo:RO_0000057 "Andy Brown")
AnnotationAssertion(rdfs:label obo:RO_0000057 "has participant")

# Object Property: obo:RO_0000087 (has role)

AnnotationAssertion(rdfs:label obo:RO_0000087 "has_role")

# Object Property: obo:RO_0002352 (input of)

AnnotationAssertion(obo:IAO_0000115 obo:RO_0002352 "An entity A is the 'input of' another entity B if A was put into the system, entity or software represented by B.")
AnnotationAssertion(obo:IAO_0000119 obo:RO_0002352 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:RO_0002352 "input of")
SubObjectPropertyOf(obo:RO_0002352 obo:RO_0000056)

# Object Property: obo:RO_0002353 (output of)

AnnotationAssertion(obo:IAO_0000112 obo:RO_0002353 "A piece of software can be the output of a particular software company via a software publishing process; data might be the output of a particular piece of data-producing software.")
AnnotationAssertion(obo:IAO_0000115 obo:RO_0002353 "An entity A is the 'output of' another entity B if it was produced as a result of  the functioning of entity B.")
AnnotationAssertion(obo:IAO_0000119 obo:RO_0002353 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:RO_0002353 "output of")
SubObjectPropertyOf(obo:RO_0002353 obo:RO_0000056)

# Object Property: obo:SWO_0000081 (is version of)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000081 "'is version of' provides a link between a 'version name' and the entity with that version.")
AnnotationAssertion(dcterms:creator obo:SWO_0000081 "Allyson Lister")
AnnotationAssertion(rdfs:comment obo:SWO_0000081 "For further information, please see http://softwareontology.wordpress.com/2012/06/20/versioning-in-swo/")
AnnotationAssertion(rdfs:label obo:SWO_0000081 "is version of"@en)
InverseObjectProperties(obo:SWO_0000081 obo:SWO_0004000)
ObjectPropertyDomain(obo:SWO_0000081 obo:IAO_0000129)

# Object Property: obo:SWO_0000082 (uses software)

AnnotationAssertion(obo:IAO_0000112 obo:SWO_0000082 "Cytoscape plugins would be linked to the Cytoscape application via uses software, while Microsoft Excel is linked to Microsoft Office via has_part.")
AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000082 "This property allows the linkage of two different pieces of software such that one directly executes or uses the other. The has_part relationship should instead be used to describe related but independent members of a larger software package, and 'uses platform' relationship should be used to describe which operating system(s) a particular piece of software can use.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000082 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000082 "uses software"@en)
InverseObjectProperties(obo:SWO_0000082 obo:SWO_0000157)
ObjectPropertyDomain(obo:SWO_0000082 obo:SWO_0000001)
ObjectPropertyRange(obo:SWO_0000082 obo:SWO_0000001)

# Object Property: obo:SWO_0000085 (is implemented by)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000085 "is implemented by is the relationship between an algorithm and a piece of software which includes an implementation of that software for use when the software is executed. ")
AnnotationAssertion(dcterms:creator obo:SWO_0000085 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_0000085 "is implemented by"@en)
InverseObjectProperties(obo:SWO_0000085 obo:SWO_0000740)
ObjectPropertyDomain(obo:SWO_0000085 obo:IAO_0000064)
ObjectPropertyRange(obo:SWO_0000085 obo:SWO_0000001)

# Object Property: obo:SWO_0000086 (has specified data input)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000086 "The relationship between input data which is permitted to a piece of software.")
AnnotationAssertion(dcterms:creator obo:SWO_0000086 "James Malone")
AnnotationAssertion(rdfs:comment obo:SWO_0000086 "AL 2.9.22: This cannot be a child of 'has specified input' because the restrictions on domain and range for that hierarchy would create issues for us, as both software and data item (our domain and range, respectively) are continuants. For now, the solution is to take it out of that hierarchy completely.")
AnnotationAssertion(rdfs:comment obo:SWO_0000086 "See also http://softwareontology.wordpress.com/2011/04/15/ins-and-outs-of-software/")
AnnotationAssertion(rdfs:label obo:SWO_0000086 "has specified data input")
InverseObjectProperties(obo:SWO_0000086 obo:SWO_0000088)
ObjectPropertyDomain(obo:SWO_0000086 obo:SWO_0000001)
ObjectPropertyRange(obo:SWO_0000086 obo:IAO_0000027)

# Object Property: obo:SWO_0000087 (has specified data output)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000087 "The relationship between a piece of software and the data that it is possible to output."@en)
AnnotationAssertion(dcterms:creator obo:SWO_0000087 "James Malone")
AnnotationAssertion(rdfs:comment obo:SWO_0000087 "AL 2.9.22: This cannot be a child of 'has specified output' because the restrictions on domain and range for that hierarchy would create issues for us, as both software and data item (our domain and range, respectively) are continuants. For now, the solution is to take it out of that hierarchy completely.")
AnnotationAssertion(rdfs:comment obo:SWO_0000087 "See also http://softwareontology.wordpress.com/2011/04/15/ins-and-outs-of-software/")
AnnotationAssertion(rdfs:label obo:SWO_0000087 "has specified data output"@en)
InverseObjectProperties(obo:SWO_0000087 obo:SWO_0000089)
ObjectPropertyDomain(obo:SWO_0000087 obo:SWO_0000001)
ObjectPropertyRange(obo:SWO_0000087 obo:IAO_0000027)

# Object Property: obo:SWO_0000088 (is specified data input of)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000088 "The relationship between a data and the software which can possibly take this data as input.")
AnnotationAssertion(dcterms:creator obo:SWO_0000088 "James Malone")
AnnotationAssertion(rdfs:comment obo:SWO_0000088 "AL 2.9.22: This cannot be a child of 'is specified input of' or 'input of' because the restrictions on domain and range for that hierarchy would create issues for us, as both software and data item (our range and domain, respectively) are continuants. For now, the solution is to take it out of that hierarchy completely.")
AnnotationAssertion(rdfs:label obo:SWO_0000088 "is specified data input of"@en)
ObjectPropertyDomain(obo:SWO_0000088 obo:IAO_0000027)
ObjectPropertyRange(obo:SWO_0000088 obo:SWO_0000001)

# Object Property: obo:SWO_0000089 (is specified data output of)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000089 "The relationship between a data and the software which can possibly produce this data as output.")
AnnotationAssertion(dcterms:creator obo:SWO_0000089 "James Malone")
AnnotationAssertion(rdfs:comment obo:SWO_0000089 "AL 2.9.22: This cannot be a child of 'is specified output of' or 'output of' because the restrictions on domain and range for that hierarchy would create issues for us, as both software and data item (our range and domain, respectively) are continuants. For now, the solution is to take it out of that hierarchy completely.")
AnnotationAssertion(rdfs:label obo:SWO_0000089 "is specified data output of"@en)
ObjectPropertyDomain(obo:SWO_0000089 obo:IAO_0000027)
ObjectPropertyRange(obo:SWO_0000089 obo:SWO_0000001)

# Object Property: obo:SWO_0000131 (directly preceded by)

AnnotationAssertion(obo:IAO_0000112 obo:SWO_0000131 "Microsoft version 2007 is directly preceded by Microsoft version 2003.")
AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000131 "Entity A is 'directly preceded by' entity B if there are no intermediate entities temporally between the two entities. WIthin SWO this property is mainly used to describe versions of entities such as software.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000131 "Allyson Lister")
AnnotationAssertion(dcterms:creator obo:SWO_0000131 "OBO Foundry")
AnnotationAssertion(rdfs:label obo:SWO_0000131 "directly preceded by")
SubObjectPropertyOf(obo:SWO_0000131 obo:SWO_0000301)
InverseObjectProperties(obo:SWO_0000131 obo:SWO_0000132)

# Object Property: obo:SWO_0000132 (directly followed by)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000132 "'directly followed by' is an object property which further specializes the parent 'followed by' property. In the assertion 'C directly followed by C1', says that Cs generally are immediately followed by C1s.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000132 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000132 "directly followed by"@en)
SubObjectPropertyOf(obo:SWO_0000132 obo:SWO_0000300)

# Object Property: obo:SWO_0000150 (uses platform)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000150 "'uses platform' should be used to link a particular piece of software to one or more operating systems which that software can run on. This is in contrast to both 'uses software' (which describes one piece of software directly executing another), and has_part, which can be used to describe related but independent software in a package, for example.")
AnnotationAssertion(dcterms:creator obo:SWO_0000150 "Allyson Lister")
AnnotationAssertion(rdfs:comment obo:SWO_0000150 "This property, together with 'uses software', is probably best modelled as a child of has_part. Its current position in the property hierarchy is based on simplicity of use. 'uses platform' was deemed an appropriate addition (rather than making use of already extant has_part or 'uses software') due to the already present definitions of those classes which restrict their use to particular situations.")
AnnotationAssertion(rdfs:label obo:SWO_0000150 "uses platform"@en)
ObjectPropertyDomain(obo:SWO_0000150 obo:SWO_0000001)
ObjectPropertyRange(obo:SWO_0000150 obo:SWO_0000021)

# Object Property: obo:SWO_0000157 (is software for)

AnnotationAssertion(rdfs:label obo:SWO_0000157 "is software for"@en)
ObjectPropertyDomain(obo:SWO_0000157 obo:SWO_0000001)
ObjectPropertyRange(obo:SWO_0000157 obo:SWO_0000001)

# Object Property: obo:SWO_0000300 (followed by)

AnnotationAssertion(rdfs:comment obo:SWO_0000300 "AL 2.9.22: When incorporating all BFO annotations, it became clear that we were using BFO 'precedes' (which was the original parent for 'directly followed by') incorrectly. 'precedes' has a range  and domain of occurent, and the IAO version number class is an ICE, which is a continuant. This led to an inconsistent ontology. To fix this for now, we have created a new class that performs a similar function to BFO 'precedes' but without the domain/range restrictions.")
AnnotationAssertion(rdfs:label obo:SWO_0000300 "followed by")

# Object Property: obo:SWO_0000301 (follows)

AnnotationAssertion(rdfs:comment obo:SWO_0000301 "AL 2.9.22: When incorporating all BFO annotations, it became clear that we were using BFO 'precedes' and 'preceded by' (which was the original parent for 'directly preceded by') incorrectly. 'precedes' has a range  and domain of occurent, and the IAO version number class is an ICE, which is a continuant. This led to an inconsistent ontology. To fix this for now, we have created a new class (and this, its inverse) that performs a similar function to BFO 'precedes' but without the domain/range restrictions.")
AnnotationAssertion(rdfs:label obo:SWO_0000301 "follows")

# Object Property: obo:SWO_0000394 (is developed by)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000394 "The relationship between a software and software developer.")
AnnotationAssertion(rdfs:label obo:SWO_0000394 "is developed by")
ObjectPropertyDomain(obo:SWO_0000394 obo:SWO_0000001)

# Object Property: obo:SWO_0000740 (implements)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000740 "implements is the relationship between software and an algorithm that is defined for use within that software when executed. ")
AnnotationAssertion(dcterms:creator obo:SWO_0000740 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_0000740 "implements")
ObjectPropertyDomain(obo:SWO_0000740 obo:SWO_0000001)
ObjectPropertyRange(obo:SWO_0000740 obo:IAO_0000064)

# Object Property: obo:SWO_0000741 (is encoded in)

AnnotationAssertion(obo:IAO_0000112 obo:SWO_0000741 "Linking a type of software to its particular programming language.")
AnnotationAssertion(obo:IAO_0000115 obo:SWO_0000741 "Is encoded in is an \"is about\" relationship which describes the type of encoding used for the referenced class.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0000741 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0000741 "is encoded in")
SubObjectPropertyOf(obo:SWO_0000741 <http://purl.obofoundry.org/obo/IAO_0000136>)

# Object Property: obo:SWO_0004000 (has version)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0004000 "relationship between an entity and a version name or number")
AnnotationAssertion(rdfs:comment obo:SWO_0004000 "For further information, please see http://softwareontology.wordpress.com/2012/06/20/versioning-in-swo/")
AnnotationAssertion(rdfs:label obo:SWO_0004000 "has version")
ObjectPropertyRange(obo:SWO_0004000 obo:IAO_0000129)

# Object Property: obo:SWO_0004001 (has interface)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0004001 "Provides a method of asserting what type of interactions are possible for the class in question. The interface must be from the 'software interface' hierarchy.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0004001 "Allyson Lister")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0004001 "Andy Brown")
AnnotationAssertion(dcterms:creator obo:SWO_0004001 "Andy Brown")
AnnotationAssertion(rdfs:label obo:SWO_0004001 "has interface")
ObjectPropertyRange(obo:SWO_0004001 obo:SWO_9000050)

# Object Property: obo:SWO_0004002 (has format specification)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0004002 "Has format specification is a type of \"is encoded in\" relationship which specifically describes the relationship between data and a data format specification.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0004002 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0004002 "has format specification")
SubObjectPropertyOf(obo:SWO_0004002 obo:SWO_0000741)
ObjectPropertyDomain(obo:SWO_0004002 obo:IAO_0000027)
ObjectPropertyRange(obo:SWO_0004002 obo:IAO_0000098)

# Object Property: obo:SWO_0004004 (is published by)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0004004 "'is published by' elucidates the relationship between a piece of software or a data format specification and its owning organization. Please note that this is not the same as authorship of the software. For instance, affy is published within Bioconductor, but has its own distinct authorship list.")
AnnotationAssertion(dcterms:creator obo:SWO_0004004 "Allyson Lister")
AnnotationAssertion(dcterms:creator obo:SWO_0004004 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_0004004 "is published by")
SubObjectPropertyOf(obo:SWO_0004004 owl:topObjectProperty)
ObjectPropertyDomain(obo:SWO_0004004 ObjectUnionOf(obo:IAO_0000098 obo:SWO_0000001))
ObjectPropertyRange(obo:SWO_0004004 obo:OBI_0000245)

# Object Property: obo:SWO_0004007 (obsolete object property)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0004007 "Stores those object properties which are no longer appropriate for use within SWO.")
AnnotationAssertion(dc:contributor obo:SWO_0004007 "Marked as obsolete by Allyson Lister")
AnnotationAssertion(dcterms:creator obo:SWO_0004007 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_0004007 "obsolete object property")

# Object Property: obo:SWO_0040005 (is executed in)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_0040005 "is executed in defines the relationship between a software class and an appropriate process in the information processing hierarchy. Specifically, it allows the linking of a particular piece of software to a process of a particular purpose, ")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_0040005 "Allyson Lister")
AnnotationAssertion(dcterms:creator obo:SWO_0040005 "Allyson Lister")
AnnotationAssertion(dcterms:creator obo:SWO_0040005 "OBI")
AnnotationAssertion(rdfs:label obo:SWO_0040005 "is executed in")
ObjectPropertyDomain(obo:SWO_0040005 obo:SWO_0000001)
ObjectPropertyRange(obo:SWO_0040005 obo:OBI_0200000)
ObjectPropertyRange(obo:SWO_0040005 obo:OBI_0200111)

# Object Property: obo:SWO_1000048 (is compatible license of)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_1000048 "'is compatible license of' provides a method of marking two software licenses as compatible and without conflicts, e.g. that the Apache License version 2 is compatible with GNU GPL version 3. If two licenses are connected with this property, it means code released under one license can be released with code from the other license in a larger program.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_1000048 "http://www.gnu.org/licenses/gpl-faq.html#WhatDoesCompatMean, accessed 12 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_1000048 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_1000048 "is compatible license of"@en)
SymmetricObjectProperty(obo:SWO_1000048)
ObjectPropertyDomain(obo:SWO_1000048 obo:SWO_0000002)
ObjectPropertyRange(obo:SWO_1000048 obo:SWO_0000002)

# Object Property: obo:SWO_3000054 (is alternative format of)

AnnotationAssertion(obo:IAO_0000112 obo:SWO_3000054 "The format for BioPAX Manchester OWL syntax is an alternative format of the BioPAX RDF/XML format.")
AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000054 "With both a domain and range of 'data format specification', this property provides a means of stating that two different data format specifications are valid specifications for the same type of data.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000054 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000054 "is alternative format of"@en)
SymmetricObjectProperty(obo:SWO_3000054)
ObjectPropertyDomain(obo:SWO_3000054 obo:IAO_0000098)
ObjectPropertyRange(obo:SWO_3000054 obo:IAO_0000098)

# Object Property: obo:SWO_9000067 (has declared status)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000067 "'has declared status' provides a way to assert the developmental status of a class, such as whether it is stable or under development. Is especially useful for software that might not be complete or stable yet, and when combined with version information.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000067 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000067 "has declared status")
SubObjectPropertyOf(obo:SWO_9000067 <http://purl.obofoundry.org/obo/IAO_0000136>)
ObjectPropertyRange(obo:SWO_9000067 obo:SWO_0000779)

# Object Property: obo:SWO_9001002 (has clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9001002 "Axioms using the 'has clause' property, e.g. C 'has clause' C1, provide links from the left hand class to the instances within the 'license clause' hierarchy. This provides a way to more precisely assert the constraints of the licensing applied.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9001002 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9001002 "has clause")
SubObjectPropertyOf(obo:SWO_9001002 <http://purl.obofoundry.org/obo/IAO_0000136>)
ObjectPropertyRange(obo:SWO_9001002 obo:SWO_9000005)

# Object Property: <http://purl.obolibrary.org/obo/swo/has_license> (has license)

AnnotationAssertion(obo:IAO_0000115 <http://purl.obolibrary.org/obo/swo/has_license> "The relationship between an entity and the set of legal restrictions, i.e. license, which are applied in using or otherwise interacting with that entity. Eg. relationship between software and a software license.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/swo/has_license> "has license")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/swo/has_license> obo:IAO_0000136)
InverseObjectProperties(<http://purl.obolibrary.org/obo/swo/has_license> <http://purl.obolibrary.org/obo/swo/is_license_for>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/swo/has_license> obo:SWO_0000002)

# Object Property: <http://purl.obolibrary.org/obo/swo/is_license_for> (is license for)

AnnotationAssertion(obo:IAO_0000115 <http://purl.obolibrary.org/obo/swo/is_license_for> "The relationship between an entity and the set of legal restrictions, i.e. license, which are applied in using or otherwise interacting with that entity. Eg. relationship between a software license and the software which implements it.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/swo/is_license_for> "is license for"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/swo/is_license_for> <http://purl.obofoundry.org/obo/IAO_0000136>)

# Object Property: <http://www.obofoundry.org/ro/ro.owl#has_part> (has part)

AnnotationAssertion(rdfs:comment <http://www.obofoundry.org/ro/ro.owl#has_part> "The inverse property. 'part of', contains the full official RO definition.")
AnnotationAssertion(rdfs:label <http://www.obofoundry.org/ro/ro.owl#has_part> "has part")
AnnotationAssertion(rdfs:label <http://www.obofoundry.org/ro/ro.owl#has_part> "has_part")
InverseObjectProperties(<http://www.obofoundry.org/ro/ro.owl#has_part> <http://www.obofoundry.org/ro/ro.owl#part_of>)
TransitiveObjectProperty(<http://www.obofoundry.org/ro/ro.owl#has_part>)

# Object Property: <http://www.obofoundry.org/ro/ro.owl#part_of> (part of)

AnnotationAssertion(obo:IAO_0000112 <http://www.obofoundry.org/ro/ro.owl#part_of> "Cytoscape plugins would be linked to the Cytoscape application via uses software, while Microsoft Excel is linked to Microsoft Office via has_part.")
AnnotationAssertion(obo:IAO_0000115 <http://www.obofoundry.org/ro/ro.owl#part_of> "For continuants: C part_of C' if and only if: given any c that instantiates C at a time t, there is some c' such that c' instantiates C' at time t, and c *part_of* c' at t. For processes: P part_of P' if and only if: given any p that instantiates P at a time t, there is some p' such that p' instantiates P' at time t, and p *part_of* p' at t. (Here *part_of* is the instance-level part-relation.)")
AnnotationAssertion(obo:IAO_0000115 <http://www.obofoundry.org/ro/ro.owl#part_of> "This property can be used to describe related but independent members of a larger software package. In other cases, where parts of a larger software package are independent of one another in development but one piece of software executes another directly, please use \"uses software\".")
AnnotationAssertion(obo:IAO_0000119 <http://www.obofoundry.org/ro/ro.owl#part_of> "OBO Foundry RO")
AnnotationAssertion(rdfs:label <http://www.obofoundry.org/ro/ro.owl#part_of> "part of")
TransitiveObjectProperty(<http://www.obofoundry.org/ro/ro.owl#part_of>)


