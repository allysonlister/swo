AnnotationAssertion(obo:IAO_0000118 obo:SWO_3000015 "Portable Document Format")
AnnotationAssertion(rdfs:label obo:SWO_3000015 "pdf")
SubClassOf(obo:SWO_3000015 obo:SWO_3000014)

# Class: obo:SWO_3000016 (TIFF)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000016 "TIFF is a flexible, adaptable file format for handling images and data within a single file, by including the header tags (size, definition, image-data arrangement, applied image compression) defining the image's geometry.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_3000016 "Tagged Image File Format")
AnnotationAssertion(rdfs:label obo:SWO_3000016 "TIFF")
SubClassOf(obo:SWO_3000016 obo:SWO_3000020)

# Class: obo:SWO_3000017 (JPEG)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000017 "JPEG is a lossy file format for storing images")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_3000017 "JPG")
AnnotationAssertion(rdfs:label obo:SWO_3000017 "JPEG")
SubClassOf(obo:SWO_3000017 obo:SWO_3000020)

# Class: obo:SWO_3000018 (PNG)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000018 "PNG is a bitmapped image format and video codec that employs lossless data compression.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_3000018 "Portable Network Graphics")
AnnotationAssertion(rdfs:label obo:SWO_3000018 "PNG")
SubClassOf(obo:SWO_3000018 obo:SWO_3000020)

# Class: obo:SWO_3000019 (GIF)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000019 "The Graphics Interchange Format (GIF) is a bitmap image format. The format supports up to 8 bits per pixel thus allowing a single image to reference a palette of up to 256 distinct colors. The colors are chosen from the 24-bit RGB color space. It also supports animations and allows a separate palette of 256 colors for each frame. The color limitation makes the GIF format unsuitable for reproducing color photographs and other images with continuous color, but it is well-suited for simpler images such as graphics or logos with solid areas of color. [wikipedia]")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_3000019 "Graphics Interchange Format")
AnnotationAssertion(rdfs:label obo:SWO_3000019 "GIF")
SubClassOf(obo:SWO_3000019 obo:SWO_3000020)

# Class: obo:SWO_3000020 (raster image format)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000020 "A raster image is a format for representing a rectangular grid of dots (pixels) which contains information on the specific colour of each pixel.")
AnnotationAssertion(rdfs:label obo:SWO_3000020 "raster image format")
SubClassOf(obo:SWO_3000020 obo:SWO_3000008)

# Class: obo:SWO_3000021 (vector image format)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000021 "A vector image is a collection of connected lines and curves that produce objects. This geometric description enables the image to be displayed without loss at any size rendering.")
AnnotationAssertion(rdfs:label obo:SWO_3000021 "vector image format")
SubClassOf(obo:SWO_3000021 obo:SWO_3000008)

# Class: obo:SWO_3000022 (SVG)

