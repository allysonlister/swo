    <rdfs:subClassOf rdf:nodeID="Ne2448e830f2249dd81f13db0ce648e44"/>
    <obo:IAO_0000115>This package provides a comprehensive collection of various microarray-based classification algorithms both from Machine Learning and Statistics. Variable Selection, Hyperparameter tuning, Evaluation and Comparison can be performed combined or stepwise in a user-friendly environment.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/CMA.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>'CMA'</rdfs:label>
  </rdf:Description>
