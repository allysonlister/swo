    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0200000"/>
    <obo:IAO_0000115>A normalization is a data transformation objective where the aim is to remove systematic sources of variation to put the data on equal footing in order to create a common base for comparisons.</obo:IAO_0000115>
    <obo:IAO_0000119>PERSON: Elisabetta Manduchi</obo:IAO_0000119>
    <obo:IAO_0000119>PERSON: Helen Parkinson</obo:IAO_0000119>
    <obo:IAO_0000119>PERSON: James Malone</obo:IAO_0000119>
    <dcterms:creator>James Malone</dcterms:creator>
    <rdfs:label>data normalization</rdfs:label>
  </rdf:Description>
