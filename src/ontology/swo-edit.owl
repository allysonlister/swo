AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000076 "http://support.sas.com/documentation/cdl/en/acpcref/63184/HTML/default/viewer.htm#a003103772.htm and http://en.wikipedia.org/wiki/Lotus_1-2-3, accessed 3 December 2014.")
AnnotationAssertion(dcterms:creator obo:SWO_3000076 "Allyson Lister")
AnnotationAssertion(rdfs:comment obo:SWO_3000076 "Please note that this is a collective class for all versions of the WKn format, and the specific version required should be created as necessary and placed as a child of this class.")
AnnotationAssertion(rdfs:label obo:SWO_3000076 "WKn"@en)
SubClassOf(obo:SWO_3000076 obo:SWO_3000001)

