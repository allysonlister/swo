    <rdfs:subClassOf rdf:nodeID="N1044072c1a19424e964237675ec85e73"/>
    <obo:IAO_0000115>CARMAweb allows the analysis of Affymetrix GeneChip, ABI microarrays and two color microarrays.
The analysis includes normalization and data preprocessing, detection for differentially expressed genes, cluster analysis and GO analysis. All calculations (except the cluster analysis) are performed in R using functions provided by the BioConductor packages.</obo:IAO_0000115>
    <obo:IAO_0000118>CarmaWEB</obo:IAO_0000118>
    <obo:IAO_0000119>https://carmaweb.genome.tugraz.at/carma/</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>CARMAweb</rdfs:label>
  </rdf:Description>
