    <obo:IAO_0000118>Feature Extraction Software [Agilent Technologies]</obo:IAO_0000118>
    <obo:IAO_0000118>Feature Extraction software</obo:IAO_0000118>
    <obo:IAO_0000119>http://www.chem.agilent.com/en-us/products/instruments/dnamicroarrays/featureextractionsoftware/pages/default.aspx</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>Agilent Feature Extraction Software</rdfs:label>
