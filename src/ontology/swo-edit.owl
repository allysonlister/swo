    <obo:IAO_0000115>COBRA (COnstraint-Based Reconstruction and Analysis Toolbox) includes implementations of many of the commonly used forms of constraint-based analysis such as FBA, gene deletions, flux variability analysis, sampling, and batch simulations together with tools to read in and manipulate constraint-based models.</obo:IAO_0000115>
    <obo:IAO_0000118>COnstraints Based Reconstruction and Analysis</obo:IAO_0000118>
    <dcterms:creator>Allyson Lister</dcterms:creator>
    <rdfs:label xml:lang="en">COBRA</rdfs:label>
  </rdf:Description>
