AnnotationAssertion(Annotation(obo:IAO_0000119 "https://www.spectralworks.com/products/analyzerpro/") Annotation(rdf:type owl:Axiom) obo:IAO_0000115 obo:SWO_1100136 "AnalyzerPro​ is a productivity software application for both low and high resolution LC-MS and GC-MS data with support for multiple vendors’ data. This comprehensive post-processing utility provides optimized workflows for sample-to-sample comparison, target component analysis, quantitation and library searching for data generated from any LC-MS and GC-MS platform")
AnnotationAssertion(obo:IAO_0000117 obo:SWO_1100136 "Allyson Lister")
AnnotationAssertion(dc:contributor obo:SWO_1100136 "Allyson Lister")
AnnotationAssertion(dc:contributor obo:SWO_1100136 "Mark Reuter")
AnnotationAssertion(Annotation(obo:IAO_0000119 "https://sciex.com/technology/swath-acquisition") Annotation(rdf:type owl:Axiom) obo:IAO_0000115 obo:SWO_1100137 "SWATH is the only data independent acquisition (DIA) technique that allows comprehensive detection and quantitation of virtually every detectable compound in a sample (MS/MSALL). This provides confidence in your quantitative results and virtually eliminates the risk of missing a critical component. SWATH Acquisition strategy can only be achieved through the power and speed of SCIEX TripleTOF® and QTOF technology.")
AnnotationAssertion(obo:IAO_0000117 obo:SWO_1100137 "Allyson Lister")
AnnotationAssertion(dc:contributor obo:SWO_1100137 "Allyson Lister")
AnnotationAssertion(dc:contributor obo:SWO_1100137 "Mark Reuter")
AnnotationAssertion(Annotation(obo:IAO_0000119 "https://www.proteinmetrics.com/products/supernovo/") Annotation(rdf:type owl:Axiom) obo:IAO_0000115 obo:SWO_1100138 "SupernovoTM is a unique, hands-free solution for end-to-end de novo sequencing of monoclonal antibodies (mAbs), enabling high throughput protein discovery.")
AnnotationAssertion(obo:IAO_0000117 obo:SWO_1100138 "Allyson Lister")
AnnotationAssertion(dc:contributor obo:SWO_1100138 "Allyson Lister")
AnnotationAssertion(dc:contributor obo:SWO_1100138 "Mark Reuter")
AnnotationAssertion(Annotation(obo:IAO_0000119 "Mark Reuter") Annotation(rdf:type owl:Axiom) obo:IAO_0000115 obo:SWO_1100139 "Protein Identification Software including an LC-MS/MS search engine, modification search and PTM profiling, sequence variant search, integration with de novo sequencing, and support for all types of fragment ions.")
AnnotationAssertion(obo:IAO_0000117 obo:SWO_1100139 "Allyson Lister")
AnnotationAssertion(dc:contributor obo:SWO_1100139 "Allyson Lister")
