  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000522">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N3b2e30a4f0a94424a88601b0fb028754"/>
