AnnotationAssertion(rdfs:label obo:SWO_0000507 "cosmoGUI")
SubClassOf(obo:SWO_0000507 ObjectSomeValuesFrom(obo:SWO_0000086 ObjectAllValuesFrom(obo:SWO_0004002 ObjectUnionOf(<http://edamontology.org/format_1929> obo:SWO_0000409))))
