    <dcterms:creator>Allyson Lister</dcterms:creator>
    <rdfs:comment>Please note that this is a collective class for all versions of the WKn format, and the specific version required should be created as necessary and placed as a child of this class.</rdfs:comment>
    <rdfs:label xml:lang="en">WKn</rdfs:label>
  </rdf:Description>
