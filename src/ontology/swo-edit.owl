  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000550">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="Na1c8b8253e304294b10b13c9d065fed7"/>
    <rdfs:subClassOf rdf:nodeID="N9fd2790e4c9b4586906f031c10936f58"/>
