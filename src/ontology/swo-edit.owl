    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_3000043"/>
    <obo:IAO_0000115>Tab delimited file format is a plain text file format where each field value of a record is separated from the next by a tab stop character.</obo:IAO_0000115>
    <obo:IAO_0000119>http://en.wikipedia.org/wiki/Tab-separated_values, accessed 6 June 2013.</obo:IAO_0000119>
    <dcterms:creator>Allyson Lister</dcterms:creator>
    <rdfs:label>tab delimited file format</rdfs:label>
  </rdf:Description>
