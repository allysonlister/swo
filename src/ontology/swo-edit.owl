    <rdfs:subClassOf rdf:nodeID="N5948326fb38f424ca048fe892953863b"/>
    <obo:IAO_0000115>Quality control of Affymetrix GeneChip expression data and reproducibility analysis of human whole genome chips with the MAQC reference datasets.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/yaqcaffy.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
