  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0000057">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <obo:IAO_0000112>The relation obtains, for example, when this particular process of oxygen exchange across this particular alveolar membrane has_participant this particular sample of hemoglobin at this particular time.</obo:IAO_0000112>
    <obo:IAO_0000115>Has_participant is a primitive instance-level relation between a process, a continuant, and a time at which the continuant participates in some way in the process.</obo:IAO_0000115>
    <obo:IAO_0000119>http://obo-relations.googlecode.com/svn/trunk/src/ontology/core.owl</obo:IAO_0000119>
    <dcterms:creator>Andy Brown</dcterms:creator>
    <rdfs:label>has participant</rdfs:label>
  </rdf:Description>
