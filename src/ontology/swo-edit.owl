    <rdfs:subClassOf rdf:nodeID="N7484e9ac2305426893666a86bf9510f0"/>
    <obo:IAO_0000115>This package contains a targeted clustering algorithm for the analysis of microarray data. The algorithm can aid in the discovery of new genes with similar functions to a given list of genes already known to have closely related functions.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/geneRecommender.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>geneRecommender</rdfs:label>
  </rdf:Description>
