    <rdfs:subClassOf rdf:nodeID="Nf64d8a88709a44c4ae605fed415205ab"/>
    <obo:IAO_0000115>altcdfenvs is a software package for alternative CDF environments (aka probeset mappings) and contains convenience data structures and functions to handle cdfenvs. </obo:IAO_0000115>
    <obo:IAO_0000119>http://www.bioconductor.org/packages/release/bioc/html/altcdfenvs.html, accessed May 28 2013.</obo:IAO_0000119>
    <dcterms:creator>Allyson Lister</dcterms:creator>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>altcdfenvs</rdfs:label>
  </rdf:Description>
