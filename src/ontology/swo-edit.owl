  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000369">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N4092fe9f9e194e79995ebba2184f05d3"/>
    <rdfs:subClassOf rdf:nodeID="N3f4af39382cb43ad8b8041a7a6a7cebc"/>
    <rdfs:subClassOf rdf:nodeID="N0b3c2a69cf88494d8d79aadf0bc1304e"/>
    <rdfs:subClassOf rdf:nodeID="N5f39a9e3c1154cbf83fa75a645728f37"/>
    <rdfs:subClassOf rdf:nodeID="Nd45bc91a3b4f48dd85b65e43061968cd"/>
    <rdfs:subClassOf rdf:nodeID="N39ace8e2c36942fabbb2c3f9876177fb"/>
    <obo:IAO_0000115>Rtreemix is a package that offers an environment for estimating the mutagenetic trees mixture models from cross-sectional data and using them for various predictions. It includes functions for fitting the trees mixture models, likelihood computations, model comparisons, waiting time estimations, stability analysis, etc.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/Rtreemix.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>Rtreemix</rdfs:label>
