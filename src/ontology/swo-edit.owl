AnnotationAssertion(obo:IAO_0000118 obo:SWO_5000003 "Desktop GUI")
AnnotationAssertion(dcterms:creator obo:SWO_5000003 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_5000003 "desktop graphical user interface"@en)
SubClassOf(obo:SWO_5000003 obo:SWO_9000052)

# Class: obo:SWO_5000004 (SOAP service)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_5000004 "A SOAP service is a Web service which provides a standard, extensible, composable framework for packaging and exchanging XML messages. The service may expose an arbitrary, application-specific set of operations.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_5000004 "SOAP Service")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_5000004 "Modified from http://en.wikipedia.org/wiki/SOAP, accessed 6 June 2013; modified from http://www.w3.org/TR/ws-arch, accessed 6 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_5000004 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_5000004 "SOAP service"@en)
SubClassOf(obo:SWO_5000004 obo:SWO_9000051)

# Class: obo:SWO_5000005 (REST service)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_5000005 "A REST service is a Web service in which the primary purpose of the service is to manipulate XML representations of Web resources using a uniform set of \"stateless\" operations. RESTful APIs do not require XML-based web service protocols (SOAP and WSDL) to support their light-weight interfaces.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_5000005 "REST Service")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_5000005 "Modified from http://www.w3.org/TR/ws-arch, accessed 6 June 2013, Modified from http://en.wikipedia.org/wiki/Web_service, accessed 6 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_5000005 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_5000005 "REST service"@en)
SubClassOf(obo:SWO_5000005 obo:SWO_9000051)

