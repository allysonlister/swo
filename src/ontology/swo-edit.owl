    <obo:IAO_0000115>minimum common regions (MCR) algorithm- Minimal common regions (MCRs) are dened as contiguous spans having at least a recurrence rate dened by a parameter (recurrence) across samples.</obo:IAO_0000115>
    <rdfs:label>MCR algorithm</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000781">
