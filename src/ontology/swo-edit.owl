    <rdfs:subClassOf rdf:nodeID="N6ce87314963946899d7fde51c049c628"/>
    <obo:IAO_0000115>This package implements a Kolmogorov Smirnov rank-sum based algorithm for training and classification of gene expression data sets. One of the chief strengths of this approach is that it is amenable to the "multiclass" problem. That is, it can discriminate between more than 2 classes.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/dualKS.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>'dualKS'</rdfs:label>
  </rdf:Description>
