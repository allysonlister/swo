SubClassOf(obo:SWO_1100112 ObjectSomeValuesFrom(obo:SWO_0000087 ObjectIntersectionOf(obo:IAO_0000027 ObjectSomeValuesFrom(obo:SWO_0004002 obo:SWO_0000409))))

