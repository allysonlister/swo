  <rdf:Description rdf:nodeID="Nb23c977460694b9d9415596b2f0d4a70">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SWO_1100141"/>
    <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
    <owl:annotatedTarget>RNA-SeQC is a java program which computes a series of quality control metrics for RNA-seq data. The input can be one or more BAM files. The output consists of HTML reports and tab delimited files of metrics data. This program can be valuable for comparing sequencing quality across different samples or experiments to evaluate different experimental parameters. It can also be run on individual samples as a means of quality control before continuing with downstream analysis.</owl:annotatedTarget>
    <obo:IAO_0000119>Mark Reuter</obo:IAO_0000119>
  </rdf:Description>
