  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000544">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="Nad1264d5b8cd4fe9bb05c27541f2a0a8"/>
    <rdfs:subClassOf rdf:nodeID="Ndde40c9aada847d493ecf9eea9829f87"/>
    <rdfs:subClassOf rdf:nodeID="N867f164757de4213a8b2b42dcbc2e709"/>
    <rdfs:subClassOf rdf:nodeID="N3514a6271e3f40e9b7cb7d05b09a778d"/>
    <rdfs:subClassOf rdf:nodeID="N0f2ba8c756f5411f80a8350fde66fea5"/>
    <rdfs:subClassOf rdf:nodeID="Nf01f1991434144729cbed5d6526bdf23"/>
    <obo:IAO_0000115>This package fits Rossell's generalizations of the Gamma-Gamma hierarchical model for microarray data analysis, which substantially improve the quality of the fit at a low computational cost. The model can be fit via empirical Bayes (Expectation-Maximization and Simulated Annealing) and fully Bayesian techniques (Gibbs and Metropolis-Hastings posterior sampling).</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/gaga.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>gaga</rdfs:label>
  </rdf:Description>
