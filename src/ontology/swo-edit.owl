    <rdfs:subClassOf rdf:nodeID="Ne3bf18fd0ed04cfba203f54297dce6c0"/>
    <rdfs:subClassOf rdf:nodeID="N3c8858bbe7504cef91c1f7de8f12e8f1"/>
    <obo:IAO_0000115>This LPE library is used to do significance analysis of microarray data with small number of replicates. It uses resampling based FDR adjustment, and gives less conservative results than traditional 'BH' or 'BY' procedures. Data accepted is raw data in txt format from MAS4, MAS5 or dChip. Data can also be supplied after normalization. LPE library is primarily used for analyzing data between two conditions. To use it for paired data, see LPEP library. For using LPE in multiple conditions, use HEM library.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/LPE.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>LPE</rdfs:label>
  </rdf:Description>
