AnnotationAssertion(obo:IAO_0000118 obo:SWO_5000002 "WUI")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_5000002 "Web UI")
AnnotationAssertion(dcterms:creator obo:SWO_5000002 "Allyson Lister")
