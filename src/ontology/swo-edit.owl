    <rdfs:subClassOf rdf:nodeID="N7551fda8e8e0456d8973e72891fafdab"/>
    <rdfs:subClassOf rdf:nodeID="N82dcc4dd17c94c8aa1c67dcd5653d9f0"/>
    <rdfs:subClassOf rdf:nodeID="Nec46ad69268b4773bfbab53f9f372cfa"/>
    <obo:IAO_0000115>This library contains functions that calculate various statistics of differential expression for microarray data, including t statistics, fold change, F statistics, SAM, moderated t and F statistics and B statistics. It also implements a new methodology called DEDS (Differential Expression via Distance Summary), which selects differentially expressed genes by integrating and summarizing a set of statistics using a weighted distance approach.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/DEDS.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>'DEDS'</rdfs:label>
  </rdf:Description>
