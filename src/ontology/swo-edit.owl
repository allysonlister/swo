# Class: obo:SWO_3000046 (tab delimited file format)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000046 "Tab delimited file format is a plain text file format where each field value of a record is separated from the next by a tab stop character.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000046 "http://en.wikipedia.org/wiki/Tab-separated_values, accessed 6 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_3000046 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000046 "tab delimited file format")
SubClassOf(obo:SWO_3000046 obo:SWO_3000043)

# Class: obo:SWO_3000049 (SIF)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000049 "SIF stands for Simple Interaction Format, and is a text format invented for Cytoscape. If the file contains any tab characters, then tabs are used to delimit the fields and spaces are considered part of the name. If the file contains no tabs, then any spaces are delimiters that separate names (and names cannot contain spaces). ")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000049 "http://wiki.cytoscape.org/GettingStarted and http://wiki.cytoscape.org/Cytoscape_User_Manual/Network_Formats, accessed 20 June 2012")
AnnotationAssertion(dcterms:creator obo:SWO_3000049 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000049 "SIF"@en)
SubClassOf(obo:SWO_3000049 <http://edamontology.org/format_2330>)

# Class: obo:SWO_3000050 (GML)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000050 "GML stands for Graph Markup Language, and is a standard network file format; supported by multiple generic network software packages ")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000050 "http://wiki.cytoscape.org/GettingStarted, accessed 20 June 2012")
AnnotationAssertion(rdfs:label obo:SWO_3000050 "GML"@en)
SubClassOf(obo:SWO_3000050 <http://edamontology.org/format_2332>)

# Class: obo:SWO_3000051 (XGMML)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000051 "XGMML stands for eXtensible Graph Markup and Modelling Language, and it is a XML standard; similar to but preferred over GML.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000051 "http://wiki.cytoscape.org/GettingStarted, accessed 20 June 2012")
AnnotationAssertion(rdfs:label obo:SWO_3000051 "XGMML"@en)
SubClassOf(obo:SWO_3000051 <http://edamontology.org/format_2332>)

# Class: obo:SWO_3000052 (Interaction data)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000052 "A type of data which defines interactions between items in the file. This can be simple pairwise interactions or more complex ones. Used to provide a class of data for software requiring specific types of interaction data as input.")
AnnotationAssertion(dcterms:creator obo:SWO_3000052 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000052 "Interaction data"@en)
SubClassOf(obo:SWO_3000052 obo:IAO_0000027)

# Class: obo:SWO_3000053 (Knowledge representation)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000053 "A knowledge representation role is a role borne by a data format which utilizes formalisms to make complex systems easier to design and build. Knowledge representation is the field of artificial intelligence devoted to representing information about the world in a form that a computer system can utilize to solve complex tasks.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000053 "Modified from http://en.wikipedia.org/wiki/Knowledge_representation, accessed 10 February 2014")
AnnotationAssertion(rdfs:comment obo:SWO_3000053 "AL 6.9.22: This has been moved from 'role' and used to be called 'knowledge representation role'. The issue in its former placement is to do with the domain and range of role. Bcause this class is intended as a role for a data format, it means that we use it for various children of IAO data format specification (http://purl.obolibrary.org/obo/IAO_0000098). has_role is an RO property with a domain of independent continuant, and data format specification is an ICE (a generically dependent continuant). This means we cannot use has_role for this class. Therefore, we have moved the class out of role and updated the label, and are now using 'characteristic of'/'has characteristic' instead. We may wish to refine the placement of this class in future.")
AnnotationAssertion(rdfs:label obo:SWO_3000053 "Knowledge representation"@en)
SubClassOf(obo:SWO_3000053 obo:BFO_0000017)

# Class: obo:SWO_3000055 (BioPAX RDF/XML format)

AnnotationAssertion(rdfs:comment obo:SWO_3000055 "AL 6.9.22: I would prefer to use the updated RO label 'has characteristic', but for some reason Protege only allows the use of the label RO deems older, 'bearer of'")
AnnotationAssertion(rdfs:label obo:SWO_3000055 "BioPAX RDF/XML format"@en)
SubClassOf(obo:SWO_3000055 obo:SWO_3000007)
SubClassOf(obo:SWO_3000055 ObjectSomeValuesFrom(obo:RO_0000053 obo:SWO_3000053))

# Class: obo:SWO_3000056 (BioPAX Manchester OWL Syntax format)

AnnotationAssertion(rdfs:label obo:SWO_3000056 "BioPAX Manchester OWL Syntax format"@en)
SubClassOf(obo:SWO_3000056 <http://edamontology.org/format_2330>)
SubClassOf(obo:SWO_3000056 ObjectSomeValuesFrom(obo:RO_0000053 obo:SWO_3000053))
SubClassOf(obo:SWO_3000056 ObjectSomeValuesFrom(obo:SWO_3000054 obo:SWO_3000055))

# Class: obo:SWO_3000057 (CDF ASCII format)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000057 "The CDF ASCII format is an ASCII data format specification created by Affymetrix similar to the Windows INI format. This format describes the layout for an Affymetrix GeneChip array. An array may contain Expression, Genotyping, CustomSeq, Copy Number and/or Tag probe sets. All probe set names within an array are unique. Multiple copies of a probe set may exist on a single array as long as each copy has a unique name.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000057 "http://www.affymetrix.com/support/developer/powertools/changelog/gcos-agcc/cdf.html, accessed 22 May 2013")
AnnotationAssertion(dcterms:creator obo:SWO_3000057 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000057 "CDF ASCII format"@en)
SubClassOf(obo:SWO_3000057 obo:SWO_3000042)
SubClassOf(obo:SWO_3000057 ObjectHasValue(obo:SWO_0004004 obo:SWO_1200000))

# Class: obo:SWO_3000058 (BAR)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000058 "BAR is a binary data format specification created by Affymetrix where the data is stored in big-endian format. The format of the file is a header section followed by sequences sections (one section per sequence defined). The BAR file contains one and two sample analysis results (signal and p-values) from the tiling array software.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000058 "http://www.affymetrix.com/support/developer/powertools/changelog/gcos-agcc/bar.html, accessed 22 May 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_3000058 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000058 "BAR"@en)
SubClassOf(obo:SWO_3000058 <http://edamontology.org/format_2333>)
SubClassOf(obo:SWO_3000058 ObjectHasValue(obo:SWO_0004004 obo:SWO_1200000))

# Class: obo:SWO_3000059 (CEL ASCII format)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000059 "CEL ASCII format is ASCII data format specification created by Affymetrix similar to the Windows INI format. The CEL format stores the results of the intensity calculations on the pixel values of the DAT file. This includes an intensity value, standard deviation of the intensity, the number of pixels used to calculate the intensity value, a flag to indicate an outlier as calculated by the algorithm and a user defined flag indicating the feature should be excluded from future analysis. The file stores the previously stated data for each feature on the probe array.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000059 "http://www.affymetrix.com/support/developer/powertools/changelog/gcos-agcc/cel.html, accessed 22 May 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_3000059 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000059 "CEL ASCII format"@en)
SubClassOf(obo:SWO_3000059 obo:SWO_3000042)
SubClassOf(obo:SWO_3000059 ObjectHasValue(obo:SWO_0004004 obo:SWO_1200000))

# Class: obo:SWO_3000060 (Affymetrix-compliant data)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000060 "Affymetrix-compliant data is data produced in a format compatible with Affymetrix software. This is a defined class where other data classes will be inferred to be members if they have a data format specification which has been published by Affymetrix.")
AnnotationAssertion(dcterms:creator obo:SWO_3000060 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000060 "Affymetrix-compliant data"@en)
EquivalentClasses(obo:SWO_3000060 ObjectSomeValuesFrom(obo:SWO_0004002 ObjectIntersectionOf(obo:IAO_0000098 ObjectHasValue(obo:SWO_0004004 obo:SWO_1200000))))
SubClassOf(obo:SWO_3000060 obo:IAO_0000027)

# Class: obo:SWO_3000061 (Data File Standard for Flow Cytometry)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000061 "The flow cytometry data file standard provides the specifications needed to completely describe flow cytometry data sets within the confines of the file containing the experimental data. The principal goal of the Standard is to provide a uniform file format allowing files created by one type of acquisition hardware and software to be analyzed by another type.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_3000061 "FCS")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000061 "http://www.bioconductor.org/packages/2.12/bioc/vignettes/prada/inst/doc/fcs3.html, accessed May 29. 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_3000061 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000061 "Data File Standard for Flow Cytometry"@en)
SubClassOf(obo:SWO_3000061 obo:SWO_3000042)

# Class: obo:SWO_3000062 (FCS3.0)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000062 "FCS3.0 is version 3.0 of the Data File Standard for Flow Cytometry. It contains a mechanism for handling data sets of 100 megabytes and larger, support for UNICODE text for keyword values, support for cyclic redundancy check (CRC) validation for each data set, a requirement for the inclusion of information describing the method of signal amplification and increased support for the inclusion of time as a measurement parameter.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_3000062 "http://www.bioconductor.org/packages/2.12/bioc/vignettes/prada/inst/doc/fcs3.html, accessed May 29. 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_3000062 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_3000062 "FCS3.0"@en)
SubClassOf(obo:SWO_3000062 obo:SWO_3000061)
