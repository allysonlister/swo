AnnotationAssertion(rdfs:label obo:SWO_1100137 "SWATH Software")
AnnotationAssertion(Annotation(obo:IAO_0000119 "https://www.proteinmetrics.com/products/supernovo/") Annotation(rdf:type owl:Axiom) obo:IAO_0000115 obo:SWO_1100138 "SupernovoTM is a unique, hands-free solution for end-to-end de novo sequencing of monoclonal antibodies (mAbs), enabling high throughput protein discovery.")
