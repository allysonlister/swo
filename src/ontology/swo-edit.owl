  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_1100088">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N38908c95ae634ef2970c9c075200b1a8"/>
    <rdfs:subClassOf rdf:nodeID="Nab59335268b2465cac3c1db42e954f45"/>
    <rdfs:subClassOf rdf:nodeID="Naac7a3a1415b49d988c5799a41069c61"/>
    <rdfs:subClassOf rdf:nodeID="N5aded3849dc447b896ee79354c5d0cbe"/>
