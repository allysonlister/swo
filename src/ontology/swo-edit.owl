AnnotationAssertion(Annotation(obo:IAO_0000119 "https://www.thermofisher.com/order/catalog/product/CHROMELEON7#/CHROMELEON7") Annotation(rdf:type owl:Axiom) obo:IAO_0000115 obo:SWO_1100135 "Chromeleon software provides full integration of Thermo Scientific gas chromatography (GC-MS/MS), liquid chromatography (LC-MS/MS), and ion chromatography (IC-MS) instruments.")
