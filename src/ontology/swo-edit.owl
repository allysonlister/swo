# Class: obo:SWO_7000005 (averaging)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000005 "An averaging objective is a data transformation objective where the aim is to perform mean calculations on the input of the data transformation.")
AnnotationAssertion(dcterms:creator obo:SWO_7000005 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000005 "averaging")
SubClassOf(obo:SWO_7000005 obo:OBI_0200000)

# Class: obo:SWO_7000006 (center calculation)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000006 "A center calculation objective is a data transformation objective where the aim is to calculate the center of an input data set.")
AnnotationAssertion(dcterms:creator obo:SWO_7000006 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000006 "center calculation")
SubClassOf(obo:SWO_7000006 obo:OBI_0200000)

# Class: obo:SWO_7000007 (class discovery)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000007 "A class discovery objective (sometimes called unsupervised classification) is a data transformation objective where the aim is to organize input data  (typically vectors of attributes) into classes, where the number of classes and their specifications are not known a priori. Depending on usage, the class assignment can be definite or probabilistic.")
AnnotationAssertion(dcterms:creator obo:SWO_7000007 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000007 "class discovery")
SubClassOf(obo:SWO_7000007 obo:OBI_0200000)

# Class: obo:SWO_7000008 (class prediction)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000008 "A class prediction objective (sometimes called supervised classification) is a data transformation objective where the aim is to create a predictor from training data through a machine learning technique. The training data consist of pairs of objects (typically vectors of attributes) and class labels for these objects. The resulting predictor can be used to attach class labels to any valid novel input object. Depending on usage, the prediction can be definite or probabilistic. A classification is learned from the training data and can then be tested on test data.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000008 "PERSON: Elisabetta Manduchi")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000008 "PERSON: James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000008 "class prediction")
SubClassOf(obo:SWO_7000008 obo:OBI_0200000)

# Class: obo:SWO_7000010 (correction)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000010 "A correction is where the aim is to correct for error, noise or other impairments to the input of the data transformation or derived from the data transformation itself.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000010 "PERSON: James Malone")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000010 "PERSON: Melanie Courtot")
AnnotationAssertion(rdfs:label obo:SWO_7000010 "correction")
SubClassOf(obo:SWO_7000010 obo:OBI_0200000)

# Class: obo:SWO_7000011 (background correction)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000011 "A background correction is where the aim is to remove irrelevant contributions from the measured signal, e.g. those due to instrument noise or sample preparation.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000011 "PERSON: Elisabetta Manduchi")
AnnotationAssertion(dcterms:creator obo:SWO_7000011 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000011 "background correction")
SubClassOf(obo:SWO_7000011 obo:SWO_7000010)

# Class: obo:SWO_7000012 (error correction)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000012 "An error correction is a data transformation objective where the aim is to remove (correct for) erroneous contributions arising from the input data, or the transformation itself.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000012 "PERSON: James Malone")
AnnotationAssertion(dcterms:creator obo:SWO_7000012 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000012 "error correction")
SubClassOf(obo:SWO_7000012 obo:SWO_7000010)

# Class: obo:SWO_7000013 (cross validation)

AnnotationAssertion(rdfs:label obo:SWO_7000013 "cross validation")
SubClassOf(obo:SWO_7000013 obo:OBI_0200000)

# Class: obo:SWO_7000014 (curve fitting)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000014 "curve fitting is a data transformation in which the aim is to find a curve which matches a series of data points and possibly other constraints.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000014 "PERSON: Elisabetta Manduchi")
AnnotationAssertion(dcterms:creator obo:SWO_7000014 "Elisabetta Manduchi")
AnnotationAssertion(dcterms:creator obo:SWO_7000014 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000014 "curve fitting")
SubClassOf(obo:SWO_7000014 obo:OBI_0200000)

# Class: obo:SWO_7000015 (data normalization)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000015 "A normalization is a data transformation objective where the aim is to remove systematic sources of variation to put the data on equal footing in order to create a common base for comparisons.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000015 "PERSON: Elisabetta Manduchi")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000015 "PERSON: Helen Parkinson")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000015 "PERSON: James Malone")
AnnotationAssertion(dcterms:creator obo:SWO_7000015 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000015 "data normalization")
SubClassOf(obo:SWO_7000015 obo:OBI_0200000)

# Class: obo:SWO_7000016 (decision tree induction)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000016 "A decision tree induction objective is a data transformation objective in which a tree-like graph of edges and nodes is created and from which the selection of each branch requires that some type of logical decision is made.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000016 "PERSON: James Malone")
AnnotationAssertion(dcterms:creator obo:SWO_7000016 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_7000016 "decision tree induction")
SubClassOf(obo:SWO_7000016 obo:OBI_0200000)

# Class: obo:SWO_7000017 (descriptive statistical calculation)

AnnotationAssertion(obo:IAO_0000112 obo:SWO_7000017 "mean calculation")
AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000017 "A descriptive statistical calculation objective is a data transformation objective which concerns any calculation intended to describe a feature of a data set, for example, its center or its variability.")
AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000017 "James Malone")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000017 "PERSON: Elisabetta Manduchi")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000017 "PERSON: James Malone")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000017 "PERSON: Melanie Courtot")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_7000017 "PERSON: Monnie McGee")
AnnotationAssertion(rdfs:label obo:SWO_7000017 "descriptive statistical calculation")
SubClassOf(obo:SWO_7000017 obo:OBI_0200000)

# Class: obo:SWO_7000018 (differential expression analysis)

AnnotationAssertion(rdfs:label obo:SWO_7000018 "differential expression analysis")
SubClassOf(obo:SWO_7000018 obo:OBI_0200000)

# Class: obo:SWO_7000019 (feature extraction)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_7000019 "A feature extraction objective is a data transformation objective where the aim of the data transformation is to generate quantified values from a scanned image.")
AnnotationAssertion(rdfs:label obo:SWO_7000019 "feature extraction")
SubClassOf(obo:SWO_7000019 obo:OBI_0200000)

# Class: obo:SWO_9000005 (licence clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000005 "A licence clause is a component of a licence which defines some aspect of a restriction or conversely permission in how something corresponding to a licence may be legally redistributed, partially redistrubed, extended, modified or otherwise used in some way.")
AnnotationAssertion(dcterms:creator obo:SWO_9000005 "James Malone")
AnnotationAssertion(rdfs:label obo:SWO_9000005 "clause")
AnnotationAssertion(rdfs:label obo:SWO_9000005 "licence clause")
SubClassOf(obo:SWO_9000005 obo:IAO_0000030)

# Class: obo:SWO_9000006 (Attribution clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000006 "An Attribution clause is a license clause intended to provide a specified level of recognition of the licensor as the copyright holder of the work. This can take many forms, including the requirement to preserve any copyright notice, attribution statements and the URL (link) to the original work. The attribution requirement thus serves the dual purpose of ensuring that the publisher receives appropriate credit, and that provenance information is kept intact. There are varying strengths of these clauses, from licensors requesting not to be attributed at all to requiring attribution for all uses of the resource.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000006 "Modified by Allyson Lister from http://creativecommons.org/tag/attribution")
AnnotationAssertion(rdfs:label obo:SWO_9000006 "Attribution clause")
SubClassOf(obo:SWO_9000006 obo:SWO_9000005)

# Class: obo:SWO_9000007 (Derivatives clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000007 "Derivatives clauses are license clauses which state what requirements on derivative resource, if any, are attached to a license. The license for a resource may or may not allow the creation of new resources derived from it. If it is allowed, such usage may be restricted in a variety of ways.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000007 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000007 "Derivatives clause")
SubClassOf(obo:SWO_9000007 obo:SWO_9000005)

# Class: obo:SWO_9000008 (Source code clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000008 "A source code clause is a license clause which states the restrictions placed on the source code for the licensed software, if any. The license for a piece of software may or may not allow access to the source code. If such access is allowed, usage may be restricted in a variety of ways.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000008 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000008 "Source code clause")
SubClassOf(obo:SWO_9000008 obo:SWO_9000005)

# Class: obo:SWO_9000009 (Platform clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000009 "A Platform clause is a license clause which states the platform restrictions for the licensed resource, if any. The license for a resource may or may not allow the use of any platform. If it is allowed, such usage may be restricted in a variety of ways.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000009 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000009 "Platform clause")
SubClassOf(obo:SWO_9000009 obo:SWO_9000005)

# Class: obo:SWO_9000010 (Number of installations clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000010 "A Number of installations clause is a license clause which may limit the number of installations a particular licensee may peform.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000010 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000010 "Number of installations clause")
SubClassOf(obo:SWO_9000010 obo:SWO_9000005)

# Class: obo:SWO_9000011 (Number of users clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000011 "A Number of users clause is a license clause which may limit the number of users a particular licensee may allow to use the resource.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000011 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000011 "Number of users clause")
SubClassOf(obo:SWO_9000011 obo:SWO_9000005)

# Class: obo:SWO_9000012 (Time clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000012 "A time clause is a license clause which states the restrictions placed on the length of time the licensed resource may be used, if any. The license for a resource may or may not allow access to the resource for an unlimited time. If such access is allowed, usage may be restricted in a variety of ways.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000012 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000012 "Time clause")
SubClassOf(obo:SWO_9000012 obo:SWO_9000005)

# Class: obo:SWO_9000013 (Usage clause)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000013 "A usage clause is a license clause which states the restrictions placed on how the licensed resource may be used. The license for a resource may restrict how the licensee may use the software. If such access is allowed, usage may be restricted in a variety of ways.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000013 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000013 "Usage clause")
SubClassOf(obo:SWO_9000013 obo:SWO_9000005)

# Class: obo:SWO_9000016 (No restrictions on derivatives)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000016 "No restrictions on derivatives is a derivatives clause which places no rules or restrictions on how derivative software is created.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000016 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000016 "No restrictions on derivatives")
SubClassOf(obo:SWO_9000016 obo:SWO_10000038)
DisjointClasses(obo:SWO_9000016 obo:SWO_9000017)

# Class: obo:SWO_9000017 (Restrictions on derivative software)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000017 "Restrictions on derivative software is a derivatives clause which allows the creation of derivatives but which also places some kind of restriction on how derivative software may be created.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000017 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000017 "Restrictions on derivative software")
SubClassOf(obo:SWO_9000017 obo:SWO_10000038)

# Class: obo:SWO_9000018 (Derivatives not allowed)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000018 "Derivatives not allowed clauses are derivatives clauses which state that  derivative resources are never allowed using the licensed resource.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000018 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000018 "Derivatives not allowed")
SubClassOf(obo:SWO_9000018 obo:SWO_9000007)

# Class: obo:SWO_9000019 (derivative code same license)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000019 "Derivative code same license is a restrictive derivatives clause where derivative software must be released under the same license.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000019 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000019 "derivative code same license")
SubClassOf(obo:SWO_9000019 obo:SWO_9000017)

# Class: obo:SWO_9000020 (Source code available)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000020 "A source code available clause is a source code clause which states that the source code for the licensed software is available to the licensee. However, usage of the source code may or may not be restricted in a variety of ways.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000020 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000020 "Source code available")
SubClassOf(obo:SWO_9000020 obo:SWO_9000008)
DisjointClasses(obo:SWO_9000020 obo:SWO_9000021)

# Class: obo:SWO_9000021 (Source code unavailable)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000021 "A source code unavailable clause is a source code clause which states that the source code for the licensed software is not available to the licensee.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000021 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000021 "Source code unavailable")
SubClassOf(obo:SWO_9000021 obo:SWO_9000008)

# Class: obo:SWO_9000022 (Platform restricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000022 "Platform restricted is a platform clause which places restrictions on which platform the licensed resource may be installed on.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000022 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000022 "Platform restricted")
SubClassOf(obo:SWO_9000022 obo:SWO_9000009)
DisjointClasses(obo:SWO_9000022 obo:SWO_9000023)

# Class: obo:SWO_9000023 (Platform unrestricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000023 "Platform unrestrictred is a platform clause which does not place any restrictions on which type of platform the resource may be licensed for.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000023 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000023 "Platform unrestricted")
SubClassOf(obo:SWO_9000023 obo:SWO_9000009)

# Class: obo:SWO_9000024 (Number of installations restricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000024 "A Number of installations restricted clause is a number of installations clause which restricts the number of times the resource may be installed by any given licensee.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000024 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000024 "Number of installations restricted")
SubClassOf(obo:SWO_9000024 obo:SWO_9000010)
DisjointClasses(obo:SWO_9000024 obo:SWO_9000025)

# Class: obo:SWO_9000025 (Number of installations unrestricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000025 "A Number of installations unrestricted clause is a number of installations clause which does not restrict the number of times the resource may be installed by any given licensee.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000025 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000025 "Number of installations unrestricted")
SubClassOf(obo:SWO_9000025 obo:SWO_9000010)

# Class: obo:SWO_9000026 (Number of users restricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000026 "A Number of users restricted clause is a number of users clause which restricts the number of users the resource may have for a particular licensee. This may be number of total users, or number of concurrent users.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000026 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000026 "Number of users restricted")
SubClassOf(obo:SWO_9000026 obo:SWO_9000011)
DisjointClasses(obo:SWO_9000026 obo:SWO_9000027)

# Class: obo:SWO_9000027 (Number of users unrestricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000027 "A Number of users unrestricted clause is a number of users clause which does not restrict the number of users of the licensed resource.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000027 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000027 "Number of users unrestricted")
SubClassOf(obo:SWO_9000027 obo:SWO_9000011)

# Class: obo:SWO_9000028 (Time for use restricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000028 "Time for use restricted is a time clause which places restrictions on the length of time the licensed resource may be used.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000028 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000028 "Time for use restricted")
SubClassOf(obo:SWO_9000028 obo:SWO_9000012)
DisjointClasses(obo:SWO_9000028 obo:SWO_9000029)

# Class: obo:SWO_9000029 (Time for use unrestricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000029 "Time for use unrestrictred is a time clause which does not place any restrictions on the length of time the resource may be licensed for.")
AnnotationAssertion(rdfs:label obo:SWO_9000029 "Time for use unrestricted")
SubClassOf(obo:SWO_9000029 obo:SWO_9000012)

# Class: obo:SWO_9000030 (Usage unrestricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000030 "Usage unrestricted is a usage clause which places no restrictions on how the licensed resource may be used.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000030 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000030 "Usage unrestricted")
SubClassOf(obo:SWO_9000030 obo:SWO_9000013)
DisjointClasses(obo:SWO_9000030 obo:SWO_9000031)

# Class: obo:SWO_9000031 (Usage restricted)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000031 "Usage restricted is a usage clause which places restrictions on how the licensed resource may be used. These restrictions will vary according to the individual license.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000031 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000031 "Usage restricted")
SubClassOf(obo:SWO_9000031 obo:SWO_9000013)

# Class: obo:SWO_9000032 (Non-commercial use only)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000032 "Non-commercial use only is a usage restricted clause which restricts the use of the licensed resource only to licensees who are not commercial entites.")
AnnotationAssertion(rdfs:label obo:SWO_9000032 "Non-commercial use only")
SubClassOf(obo:SWO_9000032 obo:SWO_9000031)

# Class: obo:SWO_9000033 (Academic use only)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000033 "Academic use only is a usage restricted clause which restricts the use of the licensed resource to academic licensees only.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000033 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000033 "Academic use only")
SubClassOf(obo:SWO_9000033 obo:SWO_9000031)

# Class: obo:SWO_9000034 (derivative code linked same license)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000034 "Derivative code linked same license is a restrictive derivatives clause where code may only be linked to in derivative software that is released under the same license.")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000034 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000034 "derivative code linked same license")
SubClassOf(obo:SWO_9000034 obo:SWO_9000017)

# Class: obo:SWO_9000050 (software interface)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000050 "The mode of interaction with a piece of software.")
AnnotationAssertion(rdfs:label obo:SWO_9000050 "software interface")
SubClassOf(obo:SWO_9000050 obo:IAO_0000030)

# Class: obo:SWO_9000051 (web service)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000051 "A web service is a software interface which works as a method of communication between two electronic devices over the World Wide Web and which is provided at a particular network address. There are two major classes of Web services: REST-compliant Web services, and arbitrary (or application-specific) Web services.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_9000051 "Web Service")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000051 "Modified from http://www.w3.org/TR/ws-arch/, accessed 6 June 2013; Modified from http://en.wikipedia.org/wiki/Web_service, accessed 6 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_9000051 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000051 "web service")
SubClassOf(obo:SWO_9000051 obo:SWO_9000050)

# Class: obo:SWO_9000052 (graphical user interface)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000052 "A Graphical user interface is a type of software interface that allows users to interact with electronic devices using images rather than text commands. A GUI represents the information and actions available to a user through graphical icons and visual indicators such as secondary notation, as opposed to text-based interfaces, typed command labels or text navigation.")
AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000052 "https://en.wikipedia.org/wiki/Graphical_user_interface, accessed 6 June 2013.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_9000052 "GUI")
AnnotationAssertion(dcterms:creator obo:SWO_9000052 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_9000052 "graphical user interface")
SubClassOf(obo:SWO_9000052 obo:SWO_9000050)

# Class: obo:SWO_9000053 (command-line interface)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000053 "A command-line interface is a means of interacting with a computer program where the user (or client) issues commands to the program in the form of successive lines of text (command lines).")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_9000053 "Command line")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_9000053 "Command line interface")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_9000053 "Command-line")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000053 "http://en.wikipedia.org/wiki/Command-line_interface, accessed 25 November 2014.")
AnnotationAssertion(rdfs:label obo:SWO_9000053 "command-line interface")
SubClassOf(obo:SWO_9000053 obo:SWO_9000050)

# Class: obo:SWO_9000054 (application programming interface)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000054 "An application programming interface is a set of routines, protocols, and tools for building software applications. An API expresses a software component in terms of its operations, inputs, outputs, and underlying types. An API defines functionalities that are independent of their respective implementations, which allows definitions and implementations to vary without compromising each other. The API specifies how software components should interact.")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_9000054 "API")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000054 "http://en.wikipedia.org/wiki/Application_programming_interface, accessed 25 November 2014.")
AnnotationAssertion(rdfs:label obo:SWO_9000054 "application programming interface")
SubClassOf(obo:SWO_9000054 obo:SWO_9000050)

# Class: obo:SWO_9000055 (software publishing process)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000055 "The process of publishing software. Typically this process involves a software publisher performing acts such as licensing, marketing, publicising and/or providing support for a product.")
AnnotationAssertion(dcterms:creator obo:SWO_9000055 "Andy Brown")
AnnotationAssertion(rdfs:label obo:SWO_9000055 "software publishing process")
SubClassOf(obo:SWO_9000055 obo:COB_0000035)

# Class: obo:SWO_9000056 (software development)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000056 "The process of developing software, typically involving the design, implementation and testing of software.")
AnnotationAssertion(dcterms:creator obo:SWO_9000056 "Andy Brown")
AnnotationAssertion(rdfs:comment obo:SWO_9000056 "AL 24.9.19: Merged the now-obsolete http://www.ebi.ac.uk/swo/objective/SWO_4000007 into this class as they were describing the same concept. See also https://github.com/allysonlister/swo/issues/2"@en)
AnnotationAssertion(rdfs:label obo:SWO_9000056 "software development")
SubClassOf(obo:SWO_9000056 obo:OBI_0200000)

# Class: obo:SWO_9000059 (Distribution with notices)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_9000059 "Distribution with notices is a distribution clause in which distribution is unrestricted, except that all distributions must retain certain licence information (e.g., copyright notices).")
AnnotationAssertion(obo:IAO_0000119 obo:SWO_9000059 "Andy Brown")
AnnotationAssertion(dcterms:creator obo:SWO_9000059 "Andy Brown")
AnnotationAssertion(rdfs:label obo:SWO_9000059 "Distribution with notices")
