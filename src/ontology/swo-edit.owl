AnnotationAssertion(Annotation(obo:IAO_0000119 "https://www.spectralworks.com/products/analyzerpro/") Annotation(rdf:type owl:Axiom) obo:IAO_0000115 obo:SWO_1100136 "AnalyzerPro​ is a productivity software application for both low and high resolution LC-MS and GC-MS data with support for multiple vendors’ data. This comprehensive post-processing utility provides optimized workflows for sample-to-sample comparison, target component analysis, quantitation and library searching for data generated from any LC-MS and GC-MS platform")
AnnotationAssertion(obo:IAO_0000117 obo:SWO_1100136 "Allyson Lister")
AnnotationAssertion(dc:contributor obo:SWO_1100136 "Allyson Lister")
