    <rdfs:subClassOf rdf:nodeID="Nda2822cd931b481eb93b5c5af5ba6747"/>
    <obo:IAO_0000115>Implements classes and methods for large-scale SNP association studies</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/snpMatrix.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>snpMatrix</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000591">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N561ee315529c4b00bc6f497f92ce6f79"/>
