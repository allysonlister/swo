    <rdfs:subClassOf rdf:nodeID="Nedb9d7071bea4c37a42443b0a77c2f65"/>
    <rdfs:subClassOf rdf:nodeID="N9547545411cf49efba29338a0a1222da"/>
    <obo:IAO_0000115>lapmix is a software package for the identification of differentially expressed genes. A hierarchical Bayesian approach is used, and the hyperparameters are estimated using empirical Bayes.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/lapmix.html</obo:IAO_0000119>
    <dcterms:creator>Allyson Lister</dcterms:creator>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>lapmix</rdfs:label>
  </rdf:Description>
