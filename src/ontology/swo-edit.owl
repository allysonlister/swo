    <rdfs:subClassOf rdf:nodeID="N9273361b0eca468c9ca93e97e754668e"/>
    <obo:IAO_0000115>This package implements various algorithms for inferring mutual information networks from data. All the algorithms compute the mutual information matrix in order to infer a network. Several mutual information estimators are implemented.</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/minet.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>minet</rdfs:label>
  </rdf:Description>
