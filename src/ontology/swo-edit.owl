    <rdfs:subClassOf rdf:nodeID="N325b4be00c5244febfee2571af41b622"/>
    <obo:IAO_0000115>This package allows to characterize the operating characeristics of a microarray experiment, i.e. the trade-off between false discovery rate and the power to detect truly regulated genes. The package includes tools both for planned experiments (for sample size assessment) and for already collected data (identification of differentially expressed genes).</obo:IAO_0000115>
    <obo:IAO_0000119>http://bioconductor.org/packages/2.4/bioc/html/OCplus.html</obo:IAO_0000119>
    <dcterms:creator>Nandini Badarinarayan</dcterms:creator>
    <rdfs:label>OCplus</rdfs:label>
  </rdf:Description>
