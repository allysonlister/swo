  <rdf:Description rdf:nodeID="N191f2d6c148a478fbbbd4f0a8e545813">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SWO_1100136"/>
    <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
    <owl:annotatedTarget>AnalyzerPro​ is a productivity software application for both low and high resolution LC-MS and GC-MS data with support for multiple vendors’ data. This comprehensive post-processing utility provides optimized workflows for sample-to-sample comparison, target component analysis, quantitation and library searching for data generated from any LC-MS and GC-MS platform</owl:annotatedTarget>
    <obo:IAO_0000119>https://www.spectralworks.com/products/analyzerpro/</obo:IAO_0000119>
  </rdf:Description>
