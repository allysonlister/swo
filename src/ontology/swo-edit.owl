  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_1100137">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="N65e07c17cc11419eb4ba0d03e06f7740"/>
    <rdfs:subClassOf rdf:nodeID="Na6d8746b39d04a9d92f5580996232a71"/>
    <obo:IAO_0000115>SWATH is the only data independent acquisition (DIA) technique that allows comprehensive detection and quantitation of virtually every detectable compound in a sample (MS/MSALL). This provides confidence in your quantitative results and virtually eliminates the risk of missing a critical component. SWATH Acquisition strategy can only be achieved through the power and speed of SCIEX TripleTOF® and QTOF technology.</obo:IAO_0000115>
    <obo:IAO_0000117>Allyson Lister</obo:IAO_0000117>
    <dc:contributor>Allyson Lister</dc:contributor>
    <dc:contributor>Mark Reuter</dc:contributor>
    <dcterms:creator>Allyson Lister</dcterms:creator>
    <dcterms:creator>Mark Reuter</dcterms:creator>
    <rdfs:comment>AL 21.10.2019: Added in reference to https://github.com/allysonlister/swo/issues/30</rdfs:comment>
    <rdfs:label>SWATH Software</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SWO_0000551">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SWO_0000001"/>
    <rdfs:subClassOf rdf:nodeID="Nfd36d051f9cf4ce09445264259c4a224"/>
