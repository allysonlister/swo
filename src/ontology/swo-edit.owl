AnnotationAssertion(rdfs:label obo:SWO_3000027 "OmniOutline format")
SubClassOf(obo:SWO_3000027 obo:SWO_3000026)

# Class: obo:SWO_3000028 (OPML)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000028 "OPML (Outline Processor Markup Language) is an XML format for outlines")
AnnotationAssertion(obo:IAO_0000118 obo:SWO_3000028 "Outline Processor Markup Language")
AnnotationAssertion(rdfs:label obo:SWO_3000028 "OPML")
SubClassOf(obo:SWO_3000028 obo:SWO_3000026)

# Class: obo:SWO_3000029 (JPEG 2000)

AnnotationAssertion(obo:IAO_0000115 obo:SWO_3000029 "JPEG 2000 is a compression standard enabling both lossless and lossy storage. The compression methods used are different from the ones in standard JFIF/JPEG; they improve quality and compression ratios, but also require more computational power to process. [wikipedia]")
AnnotationAssertion(rdfs:label obo:SWO_3000029 "JPEG 2000")
SubClassOf(obo:SWO_3000029 obo:SWO_3000020)

