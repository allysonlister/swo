AnnotationAssertion(rdfs:label obo:SWO_0000207 "GOSemSim")
SubClassOf(obo:SWO_0000207 ObjectSomeValuesFrom(obo:SWO_0000086 ObjectIntersectionOf(obo:SWO_0000406 ObjectSomeValuesFrom(obo:SWO_0004002 obo:IAO_0000098))))
SubClassOf(obo:SWO_0000207 ObjectSomeValuesFrom(obo:SWO_0000087 ObjectIntersectionOf(obo:SWO_0000408 ObjectSomeValuesFrom(obo:SWO_0004002 obo:SWO_0000409))))

