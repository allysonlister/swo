AnnotationAssertion(obo:IAO_0000119 obo:SWO_1000044 "Modified from http://www.gnu.org/copyleft/copyleft.html, accessed 12 June 2013.")
AnnotationAssertion(dcterms:creator obo:SWO_1000044 "Allyson Lister")
AnnotationAssertion(rdfs:label obo:SWO_1000044 "GNU GPL Compatible License Type")
