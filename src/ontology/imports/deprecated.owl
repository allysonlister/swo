        <ns1:obsoleted_in_version>0.4</ns1:obsoleted_in_version>
        <rdfs:comment>SWO_0000586 (jpeg) was initially created within the originalsoftwareontology.owl and later moved to swo_data.owl. SWO_3000017, with the label &apos;JPEG&apos;, is also present, and stored within swo_data.owl. SWO_3000017 was retained and SWO_ 0000586 deemed obsolete, as SWO_3000017 has a better location in the hierarchy. All axioms belonging to SWO_0000586 were transferred to SWO_3000017. Please use SWO_3000017 instead.</rdfs:comment>
        <rdfs:label>obsolete_jpeg</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


