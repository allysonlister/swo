# Object Property: ns1:reason_for_obsolescence (obsolete reason_for_obsolescence)

AnnotationAssertion(rdfs:comment ns1:reason_for_obsolescence "AL 2023-03-05: Replaced by rdfs:comment as no longer within the EFO release files."@en)
AnnotationAssertion(rdfs:label ns1:reason_for_obsolescence "obsolete reason_for_obsolescence"@en)
AnnotationAssertion(owl:deprecated ns1:reason_for_obsolescence "true"^^xsd:boolean)

# Object Property: <http://www.ebi.ac.uk/efo/swo/SWO_0000394> (obsolete is developed by)

AnnotationAssertion(ns2:IAO_0100001 <http://www.ebi.ac.uk/efo/swo/SWO_0000394> ns2:SWO_0000394)
AnnotationAssertion(rdfs:comment <http://www.ebi.ac.uk/efo/swo/SWO_0000394> "AL 2023-03-05: Improperly created IRI (with 'efo' in the IRI) replaced by the correct form for SWO IRIs."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/efo/swo/SWO_0000394> "obsolete is developed by"@en)
AnnotationAssertion(owl:deprecated <http://www.ebi.ac.uk/efo/swo/SWO_0000394> "true"^^xsd:boolean)

